+def test_c4_r0550_roundtrip_byte_exact():
+    """The c4 rung (4 dots/cell = the c2 cell of a 300 dpi grid): the
+    robustness step below c3, 26x18 tiles, through the whole stack."""
+    row = make_spec("c4-r0550")
+    assert row.cell_dots == 4 and row.tiles_per_page == 468
+    payload = hashlib.sha256(b"holo-c4").digest() * 200  # 6,400 bytes
+    vplan, pages = _compose_pages(row, payload, 0.35, pages=(0,))
+    digest = hashlib.sha256(np.packbits(pages[0]).tobytes()).hexdigest()
+    assert digest == GOLDEN_C4_R0550_PAGE0, "format fork"
+    n_ok, observations, symbols = reference_decode_page(pages[0], row)
+    assert n_ok == row.tiles_per_page
+    md = metadata.decode_metadata(observations)
+    assert md.ok and md.k == vplan.k_total
+    _fountain_close(symbols, md, vplan.symbol_bits, row, 0.30, payload)
+
