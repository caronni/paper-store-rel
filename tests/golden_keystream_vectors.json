  "volume_seed_ascii": "paper-store/exp016-arch3",
  "chain": "BLAKE2b(seed+label, digest_size=16) -> int.from_bytes(le) -> numpy Philox-4x64-10 (key=int, counter=0, increment-before-block) -> Generator.integers (Lemire rejection; endpoint=False)",
  "consumption_rules": [
   "Philox key words = (key & 2^64-1, key >> 64); counter incremented with carry BEFORE each 4-word block; block words consumed in order.",
   "next32: low half of each 64-bit word first, then high half; the pending half persists across integers() calls.",
   "dtype=uint8: per-CALL byte buffer over next32 words, low byte first (4 lanes/word); value = (byte*(rng+1))>>8, reject while (m & 0xFF) < (0xFF-rng) % (rng+1); rng==255 -> raw bytes; rng==0 -> constant, consumes nothing.",
   "default dtype (int64): rng <= 2^32-1 routes through next32, value = (u32*(rng+1))>>32, reject while (m & 0xFFFFFFFF) < (2^32-1-rng) % (rng+1); larger rng uses next64 analogously; arrays fill C-order; scalar == size=1."
  ],
  "numpy_verified": [
   "2.4.6",
   "2.5.0"
  ],
  "reference": "src/paperholo/keystream_ref.py",
  "test": "tests/test_keystream_ref.py",
  "doctrine": "GOLDEN VECTORS \u2014 never regenerate or edit. A mismatch means the keystream chain changed, which is a printed-format fork: bump layout_version and add new vectors."
 },
