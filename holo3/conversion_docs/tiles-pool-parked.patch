new file mode 100644
index 0000000..ddf5d28
--- /dev/null
+++ b/holo3/tests/test_h3_plugins_pool.py
@@ -0,0 +1,370 @@
+"""tiles.pool — the cross-capture pooled-evidence residue row.
+
+The existence proof at the bottom is the row's whole reason to exist:
+two captures, two overlapping windows each, one independent noise draw
+per window on the same printed field. Every single view fails at the
+heavy budget, the winner-take-all union of the two captures fails, and
+the pooled assembly certifies — with the right bits.
+"""
+from __future__ import annotations
+
+from fractions import Fraction
+
+import numpy as np
+import pytest
+
+from holo3 import engine as engine_module
+from holo3.lib import decimate
+from holo3.plugins import tiles, tiles_pool
+from holo3.tests import _h3_facts, _h3_support
+
+PPC = Fraction(4)
+OTHER_PPC = Fraction(8)
+CAP_X = "1a" * 32
+CAP_Y = "2b" * 32
+EXTENT_1 = (0, 0, 64, 64)
+EXTENT_2 = (0, 0, 64, 128)
+ADDRESS = (0, 0, 0)
+STREAM = "main"
+LOSS_BEST = 0.10
+LOSS_WORST = 0.20
+
+# the existence proof's channel: one amplitude inside the measured
+# window where the pooled assembly closes and nothing else does
+# (scratch sweep 2026-08-30: pool certifies from 1.2, union only from
+# 1.6, a single view only from 2.4, at this noise)
+PROOF_AMP = 1.3
+PROOF_NOISE_SD = 2.0
+PROOF_BITS_SEED = 7
+PROOF_NOISE_SEEDS = (101, 102, 201, 202)
+
+
+def _engine_row() -> tuple[object, object]:
+    instance = _h3_facts.new_engine()
+    return instance.row, instance.geometry
+
+
+ROW, GEOMETRY = _engine_row()
+
+
+def _store(*rows: tuple[str, tuple[int, int, int, int], float, object],
+           captures: tuple[tuple[str, tuple[Fraction, ...]], ...] = (
+               (CAP_X, (PPC,)), (CAP_Y, (PPC,)))) -> object:
+    instance = _h3_facts.new_engine()
+    for capture_id, ppcs in captures:
+        instance._fold(_h3_facts.capture(capture_id, ppcs))
+    for capture_id, extent, loss, printed in rows:
+        instance._fold(_h3_facts.evidence(
+            wid=(capture_id, 0, 0, extent), loss=loss, printed=printed))
+    return instance
+
+
+def _attempt_fact(stage: str, outcome: str) -> object:
+    page, ty, tx = ADDRESS
+    from holo3.data import AttemptFact
+
+    return AttemptFact(
+        page=page, ty=ty, tx=tx, stream_id=STREAM, stage=stage,
+        outcome=outcome, n_informative=3000, n_iters=150,
+        syndrome_ok=False, crc_ok=False, components=((CAP_X, 0),))
+
+
+# ---------------------------------------------------------------- pairing
+
+
+def test_a_single_capture_tile_never_births_the_pool_row():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   captures=((CAP_X, (PPC,)),))
+    assert tiles_pool.shared_cover_ppcs(store, *ADDRESS) == ()
+    assert tiles_pool._pool_subjects(
+        store, _attempt_fact(tiles.STAGE_SCAN, tiles.OUTCOME_FAILED)) == ()
+
+
+def test_two_distinct_captures_at_one_exact_rung_mint_the_pool_subject():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_Y, EXTENT_1, LOSS_BEST, 3.0))
+    page, ty, tx = ADDRESS
+    _h3_support.assert_golden(
+        "pool subject at the shared rung",
+        tiles_pool._pool_subjects(
+            store, _attempt_fact(tiles.STAGE_SCAN, tiles.OUTCOME_FAILED)),
+        ((page, ty, tx, PPC),))
+
+
+def test_the_pool_subject_is_the_union_subject_vocabulary():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_Y, EXTENT_1, LOSS_BEST, 3.0))
+    page, ty, tx = ADDRESS
+    pooled = tiles_pool._pool_subjects(
+        store, _attempt_fact(tiles.STAGE_SCAN, tiles.OUTCOME_FAILED))
+    union = tiles._union_subjects(
+        store, store.evidence((CAP_Y, 0, 0, EXTENT_1)))
+    assert pooled == union == ((page, ty, tx, PPC),), (
+        "the pool row reuses the union row's pairing, it does not invent "
+        "a second alignment")
+
+
+def test_pairing_is_fraction_equality_never_closeness():
+    near = decimate.as_fraction(float(PPC) + 1e-12)
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_Y, EXTENT_1, LOSS_BEST, 3.0),
+                   captures=((CAP_X, (PPC,)), (CAP_Y, (near,))))
+    assert near != PPC
+    assert tiles_pool.shared_cover_ppcs(store, *ADDRESS) == ()
+
+
+def test_own_capture_lanes_never_pool_with_themselves():
+    instance = _h3_facts.new_engine()
+    instance._fold(_h3_facts.capture(CAP_X, (PPC, OTHER_PPC)))
+    for level_index in (0, 1):
+        instance._fold(_h3_facts.evidence(
+            wid=(CAP_X, level_index, 0, EXTENT_1), loss=LOSS_BEST,
+            printed=3.0))
+    assert tiles_pool.shared_cover_ppcs(instance, *ADDRESS) == (), (
+        "two lanes of ONE capture are the same physical capture at two "
+        "decimations: they never pool")
+
+
+def test_a_rung_only_one_capture_reaches_mints_nothing():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_Y, EXTENT_1, LOSS_BEST, 3.0),
+                   captures=((CAP_X, (PPC, OTHER_PPC)), (CAP_Y, (PPC,))))
+    assert tiles_pool.shared_cover_ppcs(store, *ADDRESS) == (PPC,)
+
+
+# ------------------------------------------------------------ eligibility
+
+
+@pytest.mark.parametrize("stage,outcome,armed", (
+    (tiles.STAGE_SCAN, tiles.OUTCOME_FAILED, True),
+    (tiles.STAGE_UNION, tiles.OUTCOME_FAILED, True),
+    (tiles.STAGE_RETRY150, tiles.OUTCOME_FAILED, True),
+    (tiles.STAGE_SCAN, tiles.OUTCOME_BELOW_FLOOR, False),
+    (tiles.STAGE_UNION, tiles.OUTCOME_BELOW_FLOOR, False),
+    (tiles.STAGE_SCAN, tiles.OUTCOME_CERTIFIED, False),
+    (tiles.STAGE_POOL, tiles.OUTCOME_FAILED, False),
+))
+def test_only_a_non_certifying_ordinary_attempt_arms_the_row(
+        stage, outcome, armed):
+    assert tiles_pool.arms_pool(_attempt_fact(stage, outcome),
+                                False) is armed
+
+
+def test_a_below_floor_verdict_is_coverage_bound_so_it_never_arms():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_X, EXTENT_2, LOSS_WORST, -1.0),
+                   (CAP_Y, EXTENT_1, LOSS_BEST, 5.0))
+    page, ty, tx = ADDRESS
+    pooled, _multiplicity = tiles_pool.assemble_pooled(store, page, ty, tx,
+                                                       PPC)
+    union = tiles.assemble_union(store, page, ty, tx, PPC)
+    _dense, pooled_seen = tiles._combine(pooled, 1)
+    _dense, union_seen = tiles._combine(union, 1)
+    assert np.array_equal(pooled_seen, union_seen), (
+        "the pooled cut covers exactly the cells the union cut covers, "
+        "so it can never lift a below-floor verdict — which is why "
+        "below_attempt_floor does not arm the row")
+    assert tiles.OUTCOME_BELOW_FLOOR not in tiles_pool.ARMING_OUTCOMES
+
+
+def test_the_row_never_arms_off_its_own_facts():
+    assert tiles.STAGE_POOL not in tiles_pool.ARMING_STAGES
+    assert tiles.STAGE_POOL not in tiles.ORDINARY_STAGES, (
+        "and tiles.retry must not arm off a pool fact either — the two "
+        "heavy rows would chase each other"
+    )
+
+
+def test_a_certified_tile_never_arms_never_fires_and_retires():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_Y, EXTENT_1, LOSS_BEST, 3.0))
+    page, ty, tx = ADDRESS
+    subject = (page, ty, tx, PPC)
+    assert tiles_pool.arms_pool(
+        _attempt_fact(tiles.STAGE_SCAN, tiles.OUTCOME_FAILED), True) is False
+    store._fold(_h3_facts.certificate(page, ty, tx))
+    assert tiles_pool._pool_eligible(store, subject) is False
+    assert tiles_pool._pool_retire(store, subject) is True
+    assert tiles_pool.prepare_pool(store, subject, tiles.STAGE_POOL) is None
+    assert tiles_pool._pool_subjects(
+        store, _attempt_fact(tiles.STAGE_SCAN, tiles.OUTCOME_FAILED)) == ()
+
+
+def test_one_capture_alone_prepares_no_pooled_job():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_X, EXTENT_2, LOSS_WORST, 1.0),
+                   captures=((CAP_X, (PPC,)),))
+    page, ty, tx = ADDRESS
+    assert tiles_pool.prepare_pool(store, (page, ty, tx, PPC),
+                                   tiles.STAGE_POOL) is None
+
+
+# -------------------------------------------------------------- the maths
+
+
+def test_the_pooled_cell_value_is_the_equal_weight_mean_of_its_readings():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_X, EXTENT_2, LOSS_WORST, -1.0),
+                   (CAP_Y, EXTENT_1, LOSS_BEST, 5.0))
+    page, ty, tx = ADDRESS
+    components, multiplicity = tiles_pool.assemble_pooled(store, page, ty,
+                                                          tx, PPC)
+    assert multiplicity == 2
+    values = {cut.capture_id: np.unique(cut.values) for cut in components}
+    assert np.array_equal(values[CAP_X], np.array([1.0], np.float32)), (
+        "mean(+3, -1) = +1, never the winner's +3 and never the sum +2")
+    assert np.array_equal(values[CAP_Y], np.array([5.0], np.float32))
+
+
+def test_captures_are_summed_after_their_own_readings_are_averaged():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_X, EXTENT_2, LOSS_WORST, -1.0),
+                   (CAP_Y, EXTENT_1, LOSS_BEST, 5.0))
+    page, ty, tx = ADDRESS
+    components, _multiplicity = tiles_pool.assemble_pooled(store, page, ty,
+                                                           tx, PPC)
+    dense, observed = tiles._combine(components,
+                                     tiles.evidence_arity(store.row))
+    assert np.array_equal(np.unique(dense[observed]), np.array([6.0])), (
+        "mean within a capture (photons are shared), sum across captures "
+        "(the measured multi-scan law)")
+
+
+def test_the_pooled_cut_is_bit_identical_to_the_union_cut_with_no_overlap():
+    store = _store((CAP_X, EXTENT_1, LOSS_BEST, 3.0),
+                   (CAP_Y, EXTENT_1, LOSS_WORST, 7.0))
+    page, ty, tx = ADDRESS
+    pooled, multiplicity = tiles_pool.assemble_pooled(store, page, ty, tx,
+                                                      PPC)
+    union = tiles.assemble_union(store, page, ty, tx, PPC)
+    assert multiplicity == 1
+    assert len(pooled) == len(union) == 2
+    for mine, theirs in zip(pooled, union):
+        assert mine.capture_id == theirs.capture_id
+        assert mine.values.tobytes() == theirs.values.tobytes()
+        assert mine.observed_flat.tobytes() == theirs.observed_flat.tobytes()
