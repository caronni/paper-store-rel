+# --------------------------------------------------------- the whole row
+
+
+def _proof_store() -> tuple[object, np.ndarray]:
+    bits = np.random.default_rng(PROOF_BITS_SEED).integers(
+        0, 2, size=ROW.streams[0].user_bits, dtype=np.uint8)
+    field = tiles.printed_cells_for(ROW, GEOMETRY, *ADDRESS, bits)
+    truth = (2.0 * field.astype(np.float64) - 1.0).ravel()
+    rows = []
+    lanes = ((CAP_X, EXTENT_1, LOSS_BEST), (CAP_X, EXTENT_2, LOSS_WORST),
+             (CAP_Y, EXTENT_1, LOSS_BEST), (CAP_Y, EXTENT_2, LOSS_WORST))
+    for (capture_id, extent, loss), seed in zip(lanes, PROOF_NOISE_SEEDS):
+        noise = np.random.default_rng(seed).normal(
+            0.0, PROOF_NOISE_SD, truth.size)
+        rows.append((capture_id, extent, loss, PROOF_AMP * truth + noise))
+    return _store(*rows), bits
+
+
+def _outcome(components: tuple) -> object:
+    return tiles.attempt_tile(ROW, GEOMETRY, components, STREAM,
+                              tiles.STAGE_RETRY150)
+
+
+def test_the_pooled_assembly_certifies_what_no_single_view_or_union_can():
+    store, bits = _proof_store()
+    page, ty, tx = ADDRESS
+    for capture_id in (CAP_X, CAP_Y):
+        solo = tiles.assemble_tile(store, page, ty, tx, capture_id, 0)
+        assert _outcome((solo,)).fact.outcome == tiles.OUTCOME_FAILED, (
+            f"{capture_id[:4]} alone must be below threshold at bp150 — "
+            "otherwise the proof proves nothing")
+    union = tiles.assemble_union(store, page, ty, tx, PPC)
+    assert tiles.arms_union(union)
+    assert _outcome(union).fact.outcome == tiles.OUTCOME_FAILED, (
+        "the winner-take-all union of both captures fails too: this is "
+        "the residue tiles.pool exists for")
+    job = tiles_pool.prepare_pool(store, (page, ty, tx, PPC),
+                                  tiles.STAGE_POOL)
+    assert job is not None
+    result = job()
+    certificates = [fact for fact in result.facts
+                    if hasattr(fact, "user_bits")]
+    assert len(certificates) == 1
+    assert np.array_equal(certificates[0].user_bits, bits), (
+        "and the bits are the printed bits: zero-wrong stays codec-"
+        "enforced, the pooled assembly weakens no acceptance check")
+    assert certificates[0].source == "tiles/pool"
+
+
+def test_the_pooled_job_reports_its_own_cpu_and_one_outcome_per_stream():
+    store, _bits = _proof_store()
+    page, ty, tx = ADDRESS
+    result = tiles_pool.prepare_pool(store, (page, ty, tx, PPC),
+                                     tiles.STAGE_POOL)()
+    assert result.cpu_s >= 0.0
+    assert len(result.events) == len(ROW.streams)
+    assert all(event.source == "tiles/pool" for event in result.events)
