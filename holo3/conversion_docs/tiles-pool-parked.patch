@@ -0,0 +1,219 @@
+"""tiles.pool — the cross-capture pooled-evidence residue row.
+
+WHAT THE MEASURED LAW SAYS (CLAUDE.md, "Multi-scan law", F1∘F6 replicated
+3x): equal-weight combining of several scans LOSES to best-single on a
+GLOBAL detector, because the errors are print-correlated; it WINS once
+the context detector has de-correlated the context bias. holo3 already
+obeys the cross-capture half of that law — `tiles.union` sums each
+capture's post-context `printed_llr` cell by cell (`tiles._combine`), and
+`tiles.retry` re-runs that sum at the heavy budget.
+
+WHAT IT DOES NOT DO is the same thing along the WINDOW axis. Inside one
+capture, `freeze_page_owners` hands every cell to exactly one covering
+window — the one with the best held-out logloss — and throws the other
+windows' readings of that cell away. Windows overlap by construction
+(`WINDOW_CELLS` 200 on `WINDOW_STEP_CELLS` 160), and each carries its own
+pose and its own calibration/context fit, so two windows over one cell
+are two de-correlated readouts of it. Winner-take-all keeps one.
+
+`tiles.pool` is the residue tool that keeps both. For each cell it takes
+the EQUAL-WEIGHT MEAN of every reading a capture holds (a mean, never a
+sum: the readings share photons, and "never double-count the same
+physical capture" is standing law), then sums those per-capture means
+across captures exactly as union does. Where no cell is read twice the
+pooled assembly is bit-identical to union's, and the row refuses rather
+than repeat an attempt that has already been made.
+
+Everything else is ordinary: the codec gate is `tiles.attempt_tile`
+verbatim, so zero-wrong stays codec-enforced (LDPC syndrome + CRC + the
+format-known-site identity in `printed_cells_for`), and the row is purely
+additive over the residue — it can only add certificates.
+"""
+from __future__ import annotations
+
+from fractions import Fraction
+
+import numpy as np
+
+from ..data import AttemptFact, Certificate, JobResult
+from ..descriptor import Job, PluginDescriptor, Subject
+from ..lib.geometry import TILE_CELLS
+from . import tiles
+
+PLUGIN_POOL: str = "tiles.pool"
+
+POOL_COST: int = 110
+PRICES: tuple[tuple[str, int], ...] = ((tiles.STAGE_POOL, POOL_COST),)
+
+# a pooled attempt is armed by any ordinary tile attempt that did not
+# certify — including the heavy retry, whose failure is the strongest
+# evidence that the residue needs a different assembly rather than more
+# iterations. The row never arms off its own facts.
+ARMING_STAGES: tuple[str, ...] = (tiles.STAGE_SCAN, tiles.STAGE_UNION,
+                                  tiles.STAGE_RETRY150)
+ARMING_OUTCOMES: tuple[str, ...] = (tiles.OUTCOME_FAILED,
+                                    tiles.OUTCOME_BELOW_FLOOR)
+
+# the pooled cut differs from the winner-take-all cut only where some
+# cell is read more than once by one capture
+POOLED_MULTIPLICITY: int = 2
+
+
+def arms_pool(fact: AttemptFact, certified: bool) -> bool:
+    return (fact.stage in ARMING_STAGES
+            and fact.outcome in ARMING_OUTCOMES
+            and not certified)
+
+
+def shared_cover_ppcs(store: object, page: int, ty: int,
+                      tx: int) -> tuple[Fraction, ...]:
+    """Every exact-rational rung at which >=2 DISTINCT captures hold
+    evidence for this tile — the union row's pairing law, asked of one
+    tile instead of one evidence fact. Own-capture pooling is structural-
+    ly impossible: a capture's ladder is strictly ascending, so it owns
+    at most one lane per ppc (MULTIRES-SPEC)."""
+    rungs: list[Fraction] = []
+    seen: set[Fraction] = set()
+    for capture_id in store.captures():
+        capture = store.capture(capture_id)
+        if capture is None:
+            continue
+        for level in capture.levels:
+            if level.ppc in seen:
+                continue
+            seen.add(level.ppc)
+            lanes = store.cover_lanes(page, ty, tx, level.ppc)
+            if len({lane_capture for lane_capture, _index in lanes}) >= 2:
+                rungs.append(level.ppc)
+    return tuple(sorted(rungs))
+
+
+def capture_pool_cut(store: object, page: int, ty: int, tx: int,
+                     capture_id: str, level_index: int,
+                     ) -> tuple[tiles.TileCut | None, int]:
+    """One capture's pooled reading of one tile: the equal-weight mean,
+    per cell, of every evidence row of that capture covering the cell.
+
+    Returns the cut and the largest per-cell reading count, which is 1
+    exactly when the mean is the winner-take-all cut."""
+    candidates, _order_keys = tiles.tile_candidates(
+        store, page, ty, tx, capture_id, level_index)
+    arity = tiles.evidence_arity(store.row)
+    total = np.zeros((tiles.N_CELLS, arity), dtype=np.float64)
+    counts = np.zeros(tiles.N_CELLS, dtype=np.int64)
+    for _index, _page, cells_yx, _row_indices, values in candidates:
+        cells = np.asarray(cells_yx, np.int64)
+        if not cells.shape[0]:
+            continue
+        flat = ((cells[:, 0] % TILE_CELLS) * TILE_CELLS
+                + (cells[:, 1] % TILE_CELLS))
+        np.add.at(total, flat, np.asarray(values, np.float64))
+        np.add.at(counts, flat, 1)
+    observed_flat = np.flatnonzero(counts)
+    if not observed_flat.size:
+        return None, 0
+    pooled = total[observed_flat] / counts[observed_flat, None]
+    return (tiles.TileCut(capture_id, level_index, page, ty, tx,
+                          pooled.astype(np.float32),
+                          observed_flat.astype(np.uint16)),
+            int(counts.max()))
+
+
+def assemble_pooled(store: object, page: int, ty: int, tx: int,
+                    ppc: Fraction) -> tuple[tuple[tiles.TileCut, ...], int]:
+    """The pooled components of one (tile x shared rung) subject, in
+    capture order, plus the largest per-cell reading count seen."""
+    cuts: list[tiles.TileCut] = []
+    multiplicity = 0
+    for capture_id in store.captures():
+        level_index = store.level_of_ppc(capture_id, ppc)
+        if level_index is None:
+            continue
+        cut, seen = capture_pool_cut(store, page, ty, tx, capture_id,
+                                     level_index)
+        if cut is None:
+            continue
+        cuts.append(cut)
+        multiplicity = max(multiplicity, seen)
+    return tuple(cuts), multiplicity
+
+
+def prepare_pool(store: object, subject: Subject,
+                 stage: str) -> Job | None:
+    page, ty, tx, ppc = subject
+    pending = tiles.uncertified_streams(store, page, ty, tx)
+    if not pending:
+        return None
+    components, multiplicity = assemble_pooled(store, page, ty, tx, ppc)
+    if not tiles.arms_union(components):
+        return None
+    if multiplicity < POOLED_MULTIPLICITY:
+        # every cell was read once by every capture, so the pooled cut IS
+        # the winner-take-all cut and this attempt has already been made
+        # (identical inputs never re-run)
+        return None
+    row = store.row
+    site_geometry = store.geometry
+
+    def job() -> JobResult:
+        return tiles.attempt_many(row, site_geometry, components, pending,
+                                  tiles.STAGE_POOL)
+
+    return job
+
+
+def _pool_subjects(store: object, fact: object) -> tuple[Subject, ...]:
+    certified = store.has_certificate(
+        (fact.page, fact.ty, fact.tx, fact.stream_id))
+    if not arms_pool(fact, certified):
+        return ()
+    return tuple((fact.page, fact.ty, fact.tx, ppc)
+                 for ppc in shared_cover_ppcs(store, fact.page, fact.ty,
+                                              fact.tx))
+
+
+def _pool_eligible(store: object, subject: Subject) -> bool:
+    return bool(tiles.uncertified_streams(store, subject[0], subject[1],
+                                          subject[2]))
+
+
+def _pool_retire(store: object, subject: Subject) -> bool:
+    return not _pool_eligible(store, subject)
+
+
+def _pool_stage(store: object, subject: Subject) -> str | None:
+    return tiles.STAGE_POOL
+
+
+def _pool_cost(store: object, subject: Subject, stage: str,
+               attempts: int, last_cost: int) -> int:
+    """Residue price: above the ordinary payload band (20) and the cheap
+    placement rungs, below the speculative searches (wide 120, cold
+    140/150) and refine (200). Re-fires escalate on the row's own fire
+    ordinal, so a tile whose evidence keeps churning drifts behind
+    cheaper work instead of thrashing at a flat price."""
+    escalated = POOL_COST * attempts
+    return (max(POOL_COST, escalated)
+            + tiles.RUNG_COST * store.union_rung_ordinal(subject[3]))
+
+
+POOL_DESCRIPTOR = PluginDescriptor(
+    name=PLUGIN_POOL,
+    subject_kind="tile",
+    born_by=(AttemptFact,),
+    subjects_of=_pool_subjects,
+    # the union row's subscription, function object and all: the same
+    # subject vocabulary reads the same evidence
+    reads=tiles.union_reads,
+    eligible=_pool_eligible,
+    stage=_pool_stage,
+    cost=_pool_cost,
+    retire=_pool_retire,
+    prepare=prepare_pool,
+    produces=(AttemptFact, Certificate),
+    prices=PRICES,
+)
+
+__all__ = ["POOL_DESCRIPTOR", "PLUGIN_POOL", "POOL_COST", "arms_pool",
+           "assemble_pooled", "capture_pool_cut", "prepare_pool",
+           "shared_cover_ppcs"]
