+++ b/tests/holo2_oracles/test_oracle_segment_labels.py
@@ -0,0 +1,230 @@
+"""Ledger row 52 — the refinement label join, PINNED cross-tree.
+
+v1's ``certified_refine.collect_segment_labels`` joins a window's exact
+format-known pilots with certified printed cargo (``frontier.by_address``)
+into one ``(rows, cells, values, validation, weights, is_pilot,
+block_ids, certificate_ids)`` tuple. holo2's ``refine_fit.collect_labels``
+is the SAME join stated over two ``ReferenceFieldProvider``s instead of a
+``(request, spec, frontier)`` triple — its own docstring makes the
+equivalence claim ("the BASE field's site mask is exactly v1's
+``reference >= 0``... the ENRICHED field's extra sites are exactly v1's
+certified cargo") but nothing pins it (DIVERGENCE-LEDGER row 52: "NOT
+pinned: that the two produce the same ``is_pilot``/``weights`` vectors on
+one real window").
+
+This file builds ONE real window on a REAL generator page (format-space
+v2 identity, matched ``FormatSpec``/``TileFormat`` — the
+``test_oracle_certified_labels.py`` recipe), certifies the four tiles the
+window overlaps through BOTH trees' real decode chains, runs v1's window
+apparatus (``_e023c_fixtures.py``'s proven ``PoseWindow``/``PoseSegment``/
+``SegmentRefinementRequest`` builder — the ONLY way to construct a
+``SegmentRefinementRequest`` that ``_request_rows`` will accept, since it
+re-derives and cross-checks the pose/rotation/audited-cell map) to get a
+real ``SegmentRefinementRequest``, and calls v1's ``collect_segment_
+labels`` and holo2's ``collect_labels`` on the SAME window's absolute
+page cells. Every field is compared, in the SAME row order (both trees
+concatenate pilot rows then cargo rows, each group ascending by original
+cell-list position — proved here rather than assumed).
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F). ``_e023c_fixtures.py`` (``tests/holo/``) is a non-test helper
+module, reused the way ``test_oracle_crop_cases.py`` reuses
+``holo2/measure/crop_cases.py`` — a ``sys.path`` preamble, not a
+same-directory test-to-test import.
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``holo2/src/holo2/solve/refine_fit.py``'s ``collect_labels`` with
+``cargo = known & ~pilot`` changed to ``cargo = known`` (cargo rows would
+then re-include every pilot cell) — ``test_is_pilot_and_weights_agree``
+failed (16,784 rows vs v1's 16,384: 400 pilot cells double-counted),
+and passed again after the revert. Not committed here; reproduce by
+editing a checked-out copy of ``refine_fit.py`` and re-running this file.
+"""
+from __future__ import annotations
+
+import hashlib
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+_ROOT = Path(__file__).resolve().parent.parent.parent
+_HOLO_TESTS = _ROOT / "tests" / "holo"
+if str(_HOLO_TESTS) not in sys.path:
+    sys.path.insert(0, str(_HOLO_TESTS))
+
+from _e023c_fixtures import _ArrayRaster, _PageFixture, _segment_fixture  # noqa: E402
+
+from holo.core import fountain as h_fountain                    # noqa: E402
+from holo.format.descriptor import FormatSpec                   # noqa: E402
+from holo.format.resolve import resolve_format_ref as h_resolve_format_ref  # noqa: E402
+from holo.gen.compose import compose_page_cells                 # noqa: E402
+from holo.gen.emit import source_packed_for                     # noqa: E402
+from holo.gen.plan import plan_volume                            # noqa: E402
+from holo.receive import certified_refine as refine              # noqa: E402
+from holo.receive.certified_refine import CertificateFrontier    # noqa: E402
+from holo.receive.evidence import AttemptStage as HAttemptStage  # noqa: E402
+from holo.receive.payload import attempt_k_tile as h_attempt_k_tile  # noqa: E402
+
+from holo2.core import BlobRef                                   # noqa: E402
+from holo2.format.registry_rows import tile_format_for            # noqa: E402
+from holo2.format.resolve import format_row_for                  # noqa: E402
+from holo2.solve import tiles as h2_tiles                        # noqa: E402
+from holo2.solve.certified_labels import CertifiedLabelSource     # noqa: E402
+from holo2.solve.records import MintRef, TileRecord, tile_key     # noqa: E402
+from holo2.solve.reference import V1ReferenceField                # noqa: E402
+from holo2.solve.refine_fit import collect_labels as h2_collect_labels  # noqa: E402
+
+FORMAT_REF = "c3-k-r0550@8x8"          # 8x8 tiles => 512x512 cells
+IDEAL_LLR = 5.0
+_ORACLE_SHA = "de" * 32
+STREAM = "main"
+WINDOW_TILES = ((1, 1), (1, 2), (2, 1), (2, 2))   # what a (64,64)+128x128
+                                                   # window fully overlaps
+
+
+def _build_page(format_ref: str):
+    spec = h_resolve_format_ref(format_ref)
+    payload = hashlib.sha256(format_ref.encode()).digest() * 100
+    plan = plan_volume(spec, len(payload), 0.5)
+    assert plan.n_pages == 1
+    source = source_packed_for(payload, plan)
+    counters = np.arange(spec.tiles_per_page, dtype=np.int64)
+    code = h_fountain.VolumeCode(plan.k_total, plan.symbol_bits, spec.seed,
+                                 tiles_per_page=spec.tiles_per_page)
+    symbols = code.encode_symbols(source, counters)
+    field = compose_page_cells(spec, 0, symbols, plan.k_total)
+    row = format_row_for(format_ref, plan.n_pages)
+    return spec, tile_format_for(row), field
+
+
+def _llr_from(tile: np.ndarray) -> np.ndarray:
+    return (tile.astype(np.float64) * 2.0 - 1.0) * IDEAL_LLR
+
+
+class _CertifiedPlane:
+    """``CertifiedLabelSource``'s two plane reads — see
+    ``test_oracle_certified_labels.py``'s identical double."""
+
+    def __init__(self, certificates, *, stream: str = STREAM) -> None:
+        self._blobs: dict[str, np.ndarray] = {}
+        tiles: dict = {}
+        for (page, ty, tx), user_bits in certificates.items():
+            symbol = np.asarray(user_bits[1:], np.uint8)
+            sha = hashlib.sha256(symbol.tobytes()).hexdigest()
+            self._blobs[sha] = symbol
+            tiles[tile_key(page, ty, tx, stream)] = TileRecord(
+                minting=MintRef(tile_key(page, ty, tx, stream),
+                                "scan", "oracle-profile"),
+                bits_ref=BlobRef(sha, symbol.nbytes, "uint8", symbol.shape),
+                metadata_bit=int(user_bits[0]))
+        self._tiles = tiles
+
+    def index(self):
+        plane = self
+
+        class _Index:
+            tiles = plane._tiles
+            certified_tiles = tuple(sorted(plane._tiles))
+        return _Index()
+
+    def read_array(self, ref) -> np.ndarray:
+        return self._blobs[ref.sha256]
+
+
+@pytest.fixture(scope="module")
+def certified_window():
+    """One real window certified through both trees, plus each side's
+    reference-field machinery — everything the two label joins need."""
+    spec, fmt, field = _build_page(FORMAT_REF)
+    tiles_x = spec.layout.tiles_yx[1]
+
+    def tile_of(ty, tx):
+        return field[ty * 64:(ty + 1) * 64, tx * 64:(tx + 1) * 64]
+
+    certificates = []
+    holo2_bits: dict[tuple[int, int, int], np.ndarray] = {}
+    for ty, tx in WINDOW_TILES:
+        llr = _llr_from(tile_of(ty, tx))
+        _record, certificate = h_attempt_k_tile(
+            llr, spec, (0, ty, tx), HAttemptStage.SCAN,
+            source_sha256=_ORACLE_SHA, lane_id="row52-oracle",
+            component_block_ids=(hashlib.sha256(
+                f"row52-{ty}-{tx}".encode()).hexdigest(),))
+        attempt = h2_tiles.attempt_k_tile(
+            llr, fmt, (0, ty, tx), h2_tiles.AttemptStage.SCAN)
+        assert attempt.certified and attempt.user_bits is not None
+        certificates.append(certificate)
+        holo2_bits[(0, ty, tx)] = np.asarray(attempt.user_bits, np.uint8)
+
+    v1_frontier = CertificateFrontier.from_certificates(spec, certificates)
+
+    base = V1ReferenceField(fmt)
+    enriched = CertifiedLabelSource(base).field(_CertifiedPlane(holo2_bits))
+
+    # v1's window apparatus (pose, raster, calibration) — the ONLY route
+    # to a ``SegmentRefinementRequest`` ``_request_rows`` will accept.
+    ppc = 8
+    levels = np.where(field > 0, 24.0, 232.0).astype(np.float32)
+    image = np.kron(levels, np.ones((ppc, ppc), np.float32))
+    page_fixture = _PageFixture(
+        spec=spec, symbols=np.zeros((1, 1), np.uint8), field=field,
+        raster=_ArrayRaster(image, 1200.0), certificates=())
+    segment = _segment_fixture(
+        page_fixture, window_id=1, region_index=0,
+        page_origin_yx=(64, 64), shift_yx_cells=(0.125, -0.125))
+
+    return dict(spec=spec, v1_frontier=v1_frontier, base=base,
+               enriched=enriched, request=segment.request)
+
+
+# ------------------------------------------------------- the row order
+
+def test_row_order_is_pilot_then_ascending_cargo(certified_window) -> None:
+    """Both trees put pilot rows first (ascending), cargo rows second
+    (ascending) — the precondition every field comparison below relies
+    on. Checked directly rather than assumed."""
+    fx = certified_window
+    v1_labels = refine.collect_segment_labels(
+        fx["request"], fx["spec"], fx["v1_frontier"])
+    h2_labels = h2_collect_labels(
+        0, fx["request"].generation0.page_cells_yx, fx["base"],
+        fx["enriched"])
+    for labels, row_field in ((v1_labels, "generation_rows"),
+                              (h2_labels, "rows")):
+        rows = getattr(labels, row_field)
+        pilot_rows = rows[labels.is_pilot]
+        cargo_rows = rows[~labels.is_pilot]
+        assert np.all(np.diff(pilot_rows) > 0), "pilot rows must ascend"
+        assert np.all(np.diff(cargo_rows) > 0), "cargo rows must ascend"
+    assert np.count_nonzero(v1_labels.is_pilot) > 0
+    assert np.count_nonzero(~v1_labels.is_pilot) > 0, (
+        "the fixture's window must reach certified cargo, or this pin "
+        "tests an empty case")
+
+
+def test_is_pilot_and_weights_agree(certified_window) -> None:
+    """The row 52 charge, verbatim: is_pilot and weights, one real
+    window, both trees."""
+    fx = certified_window
+    v1_labels = refine.collect_segment_labels(
+        fx["request"], fx["spec"], fx["v1_frontier"])
+    h2_labels = h2_collect_labels(
+        0, fx["request"].generation0.page_cells_yx, fx["base"],
+        fx["enriched"])
+
+    # v1 calls the row-index vector ``generation_rows``; holo2's own
+    # docstring says its ``SegmentLabels`` is "v1's field for field,
+    # minus the certificate-id column" and spells this one ``rows`` —
+    # the same role, the one field renamed. Everything downstream is
+    # named identically on both sides.
+    assert v1_labels.generation_rows.shape == h2_labels.rows.shape
+    assert np.array_equal(v1_labels.generation_rows, h2_labels.rows)
+    assert np.array_equal(v1_labels.is_pilot, h2_labels.is_pilot)
+    assert np.array_equal(v1_labels.weights, h2_labels.weights)
+    assert np.array_equal(v1_labels.validation, h2_labels.validation)
+    assert np.array_equal(v1_labels.values, h2_labels.values)
+    assert np.array_equal(v1_labels.block_ids, h2_labels.block_ids)
+    assert np.array_equal(v1_labels.page_cells_yx, h2_labels.page_cells_yx)
