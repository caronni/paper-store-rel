+#!/usr/bin/env python
+"""M3 — two cheap discriminating counts (DIVERGENCE-LEDGER rows 15 & 19).
+
+    env/bin/python holo2/measure/f6_f8_counts.py f6
+    env/bin/python holo2/measure/f6_f8_counts.py f8 --sheet e029
+    env/bin/python holo2/measure/f6_f8_counts.py all \\
+        --out scratch/holo2-catchup/real/f6-f8-counts.md
+
+NOT A TEST and not collectable as one — same standing as
+``tile_differential.py``/``parity_k.py`` (``holo2/measure/README.md``): a
+``__main__`` driver run BY PATH that opens archived v1 states read-only
+(``load_session`` — a plain file read, no lock, RULINGS I5) and, for (b),
+a holo2 state directory through ``tile_differential.open_h2_store``
+(``Store.open``, read-only, same lock caveat: never run this against a
+state a decode currently has open). Its two PURE classification/tally
+functions (:func:`spatial_relevance`, :func:`compare_pooled_vs_per_pose`
++ :func:`summarize`) are pinned on synthetic data in
+``tests/holo2_oracles/test_oracle_f6_f8_counts.py`` — not under
+``holo2/tests``, because this module imports ``holo`` (the firewall
+exempts exactly ``tests/holo2_oracles/`` and
+``measure/verdicts/test_v1_parity.py``).
+
+CHARGE (K-PARITY campaign, RULINGS §J/§N, M3): two cheap discriminating
+counts scoping DIVERGENCE-LEDGER rows 15 (F6's loser/runner-up hint arm)
+and 19 (F8's word-pool firewall scope), both currently ``ABSENT``/
+``DIVERGENT`` in holo2 and both explicitly gated on a measurement before
+any build ("must measure first" in the ledger's F6/F8 package notes).
+
+-------------------------------------------------------------------------
+(a) ROW 15 — the loser (runner-up) ledger's relevance to the parity gap.
+-------------------------------------------------------------------------
+
+v1's ``LOWER_RUNNER_UP_RESERVE``/``_retained_losing_hints`` machinery
+(``receive/place.py:92-93,306,320``) retains up to
+``LOWER_RUNNERS_PER_REGION = 2`` losing candidates per region as durable
+``LosingHypothesis`` records (``state.losers``) so a LATER placement pass
+can seed a search from a near-miss instead of a cold sweep. Whether a
+later placement actually CONSUMED one (``patch.inherited_hint_id``,
+``receive/place.py:477,1151``) is NOT durable: it is folded into
+``PoseRecord.dependency_certificate_ids`` (a general provenance field
+that ALSO carries refinement/component dependencies — a poor proxy in
+both directions, verified by reading the field's every construction site
+in ``receive/production.py:265-350``) and otherwise discarded once the
+address pass returns. So the ledger's phrasing ("count certified tiles
+whose minting placement carries a non-null ``inherited_hint_id``") is not
+literally computable from an archived state; what IS exactly and cheaply
+computable, and is what this measures instead:
+
+1. ``len(state.losers)`` per sheet — the loser ledger's own durable size,
+   the necessary precondition for row 15's hint arm to matter at all
+   (zero losers retained ⇒ zero possible rescue, with no need to trace
+   consumption).
+2. For every retained loser, the tile its own anchor (``page_origin_yx``)
+   falls in, and whether that tile is v1-certified / holo2-certified
+   there (RULINGS §N names the F2-era archived holo2 states as the
+   cross-reference: ``scratch/holo2-catchup/real/parity-F2/h2-{e029,
+   xerox}``).
+3. Whether any tile v1 has and holo2 lacks (the current parity gap, per
+   ``tile_differential``'s own set difference) falls within
+   :data:`NEIGHBOR_RADIUS_TILES` of a loser's anchor — the mop-up window
+   span (``PlacementConfig.window_cells = 200`` / 64 cells/tile ≈ 3
+   tiles), i.e. "close enough that this loser's hint COULD plausibly have
+   reached that gap tile had it been consumed."
+
+-------------------------------------------------------------------------
+(b) ROW 19 — the word-pool firewall's pooled-vs-per-pose population.
+-------------------------------------------------------------------------
+
+v1's ``known_position_words`` (``receive/words.py:329``) runs ONCE PER
+LEVEL over the POOLED final word reads of every non-redundant placement
+of every region (``receive/place.py:1668-1670``); holo2's
+``quarantine.word_verdict`` runs it PER FIRE, over one committed pose's
+own reads alone. Neither v1's per-level pool nor holo2's per-fire
+population is durable (pilot/word reads are "cold-unavailable" —
+``receive/diag/seed.py``'s own docstring, §10.7), so the rerun this
+charge asks for needs the underlying ``PilotObservation``s RE-DERIVED
+from durable geometry, not read back.
+
+The v1-proven, zero-guesswork way to do that is the SAME recipe v1's own
+mop-up level uses to re-derive a base-accepted window as a calibration
+label (``receive/place.py:_label_patch``) and, closer still, the v0.42
+R-level's committed-pose re-derivation (``place_committed``/
+``_committed_patch``, ``receive/place.py:714-790``): window/pose/segment
+geometry off the durable ``PoseRecord``, region support off the durable
+``SurveyRegionRecord`` (``survey.region_from_record``), aperture pitch as
+the median committed pose pitch (exactly ``place_committed``'s own
+derivation), ``PlacementConfig()`` defaults (the frozen policy — no CLI
+override exists on this path), ``backing`` recomputed from the raster
+(``platen_backing``, a pure function). :func:`reconstruct_lane` is that
+recipe, extended by exactly the ONE call ``_committed_patch`` deliberately
+omits — ``observations_for_segment`` ("committed poses never re-enter the
+firewall word pool," by design, for MINTING; nothing stops a read-only
+measurement from asking what they would have read).
+
+Scoped to lane ``l03-16ppc-4800dpi`` (:data:`DEFAULT_LANE`) — the finest
+ORDINARY rung. Its ``LaneSpec.native_per_view`` is exactly ``1/1``
+(measured, both sheets): this lane's own raster IS the native capture,
+so the reconstruction needs no replica of v1's scale-space DECIMATION
+pipeline (``cascade._derive_level``) for the coarser lanes — a nontrivial
+numeric pipeline this measurement does not need to get bit-exact to stay
+honest. l03 is also the ordinary lane with the fullest measured coverage
+(1,961/1,961 and 1,930's own domain — see the module's own validation
+run) — the natural population for "does pooling change any tile's
+verdict." Cross-lane (l00..l03, mop-up, refine) pooling — which is where
+the row-15 losers actually sit — is explicitly OUT of this pass's scope;
+the module docstring records why rather than silently narrowing it.
+
+VALIDATION (self-check, not asserted blind): every reconstruction run
+compares its pooled conflict count against the archived state's OWN
+durable ``AddressArtifact.bch_conflicts`` for that exact lane (0 on both
+real sheets, both sides — measured) and reports the certified-vs-
+undecoded split ("certified" here means "decoded to ITS OWN tile's
+expected counter," not "state.certificates contains it" — see
+``KnownWord.certified``). A reconstruction that produced a SINGLE
+spurious conflict, or a non-conflicting decode disagreeing with its
+tile's expected counter, would fail this self-check loudly; neither
+happened on either real sheet (measured below).
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Iterable
+
+import numpy as np
+
+_HERE = Path(__file__).resolve().parent
+_ROOT = _HERE.parent.parent
+for _path in (_HERE, _ROOT / "src", _ROOT / "holo2" / "src"):
+    _str = str(_path)
+    if _str not in sys.path:
+        sys.path.insert(0, _str)
+
+from holo.format.descriptor import FormatSpec                    # noqa: E402
+from holo.format.resolve import resolve_format_ref               # noqa: E402
+from holo.receive.place import _core                             # noqa: E402
+from holo.receive.placement.geometry import (                    # noqa: E402
+    make_address_patch, platen_backing, prepare_region, sample_segment)
+from holo.receive.placement.model import (                       # noqa: E402
+    AffinePose, HISTORICAL_MIN_SUPPORT, KnownWord, PilotObservation,
+    PlacementConfig, PoseSegment, PoseWindow)
+from holo.receive.placement.reference import V1ReferenceField     # noqa: E402
+from holo.receive.placement.search import (                       # noqa: E402
+    audit_segment, observations_for_segment)
+from holo.receive.scan import Raster, open_capture                # noqa: E402
+from holo.receive.session import load_session                    # noqa: E402
+from holo.receive.session_model import SessionState               # noqa: E402
+from holo.receive.survey import region_from_record                # noqa: E402
+from holo.receive.types import LosingHypothesis, PoseRecord        # noqa: E402
+from holo.receive.words import known_position_words                # noqa: E402
+
+import tile_differential                                          # noqa: E402
+
+_TILE_CELLS = 64
+TileKey = tuple[int, int, int]                       # (page, ty, tx)
+
+#: The v1-format identity every declared K sheet in this corpus carries
+#: (``parity_k.SHEETS``'s own real-sheet rows) — named here rather than
+#: imported, since the two drivers' declared lists otherwise couple for
+#: no shared reason.
+DEFAULT_FORMAT = "L:c2-r0700@3392x2368"
+
+#: Row 19's reconstruction lane — see the module docstring for why this
+#: one (native resolution, no decimation replica needed; fullest ordinary
+#: coverage).
+DEFAULT_LANE = "l03-16ppc-4800dpi"
+
+#: Row 15's "close enough to matter" radius, in TILES: v1's mop-up window
+#: span (``PlacementConfig.window_cells = 200`` cells) divided by
+#: ``_TILE_CELLS`` — a loser's hint, if ever consumed, seeds a search
+#: local to roughly one window's own footprint, not the whole sheet.
+NEIGHBOR_RADIUS_TILES = 3
+
+
+# =========================================================================
+# (a) ROW 15 — the loser ledger census
+# =========================================================================
+
+
+def loser_tile_key(loser: LosingHypothesis,
+                    tile_cells: int = _TILE_CELLS) -> TileKey:
+    """The tile a retained runner-up hypothesis anchors to."""
+    y, x = loser.page_origin_yx
+    return (loser.page, y // tile_cells, x // tile_cells)
+
+
+def spatial_relevance(anchor: TileKey, candidates: Iterable[TileKey],
+                       radius: int = NEIGHBOR_RADIUS_TILES,
+                       ) -> tuple[TileKey, ...]:
+    """Which of ``candidates`` sit within ``radius`` tiles of ``anchor``
+    on the same page — an L-infinity (Chebyshev) box, matching a square
+    placement window's own footprint shape."""
+    page, ty, tx = anchor
+    return tuple(sorted(
+        key for key in candidates
+        if key[0] == page and abs(key[1] - ty) <= radius
+        and abs(key[2] - tx) <= radius))
+
+
+@dataclass(frozen=True)
+class LoserRow:
+    hypothesis_id: str
+    lane_id: str
+    tile: TileKey
+    v1_certified_at_anchor: bool
+    h2_certified_at_anchor: bool | None
+    nearby_v1_only_gap_tiles: tuple[TileKey, ...]
+
+
+@dataclass(frozen=True)
+class F6Census:
+    label: str
+    n_losers: int
+    n_proposals: int
+    rows: tuple[LoserRow, ...]
+    has_gap_cross_reference: bool
+
+    @property
+    def n_relevant(self) -> int:
+        """Losers with >=1 v1-only gap tile within the neighbour radius —
+        the population row 15's hint arm could conceivably touch on this
+        sheet's CURRENT parity gap, an upper bound (consumption is not
+        traced; see the module docstring)."""
+        return sum(1 for row in self.rows if row.nearby_v1_only_gap_tiles)
+
+
+def f6_census(state: SessionState, *, label: str = "",
+              v1_only: frozenset[TileKey] | None = None,
+              h2_certs: frozenset[TileKey] | None = None) -> F6Census:
+    """Pure over an already-loaded v1 state (+ optional gap cross-ref)."""
+    v1_certs = {(c.page, *c.tile_yx) for c in state.certificates
+                if c.stream_id == "main"}
+    rows = []
+    for loser in state.losers:
+        tile = loser_tile_key(loser)
+        nearby = (spatial_relevance(tile, v1_only) if v1_only is not None
+                  else ())
+        rows.append(LoserRow(
+            hypothesis_id=loser.hypothesis_id, lane_id=loser.lane_id,
+            tile=tile, v1_certified_at_anchor=tile in v1_certs,
+            h2_certified_at_anchor=(
+                None if h2_certs is None else tile in h2_certs),
+            nearby_v1_only_gap_tiles=nearby))
+    return F6Census(label=label, n_losers=len(state.losers),
+                    n_proposals=len(state.proposals), rows=tuple(rows),
+                    has_gap_cross_reference=v1_only is not None)
+
+
+def f6_report(label: str, v1_state_path: Path, *,
+             h2_state_dir: Path | None = None,
+             format_ref: str = DEFAULT_FORMAT) -> F6Census:
+    """(a)'s per-sheet driver: load, optionally cross-reference the
+    current parity gap against an F2-era archived holo2 state (read-only,
+    RULINGS §N's declared paths), census."""
+    state = load_session(v1_state_path)
+    v1_only = None
+    h2_certs = None
+    if h2_state_dir is not None:
+        v1_certs = frozenset((c.page, *c.tile_yx) for c in state.certificates
+                             if c.stream_id == "main")
+        with tile_differential.open_h2_store(h2_state_dir) as store:
+            index = tile_differential.build_h2_index(store)
+            h2_certs = frozenset(
+                tile_differential.h2_certified_tiles(index.store_index,
+                                                     "main"))
+        v1_only = v1_certs - h2_certs
+    return f6_census(state, label=label, v1_only=v1_only, h2_certs=h2_certs)
+
+
+# =========================================================================
+# (b) ROW 19 — pooled-vs-per-pose known_position_words rerun
+# =========================================================================
+
+
+def _pose_segment(row: PoseRecord, region_index: int) -> PoseSegment:
+    """The durable-record-to-geometry step ``_committed_patch`` performs,
+    verbatim (``receive/place.py:733-748``) — reused rather than
+    reimplemented so a future change to that recipe cannot silently
+    diverge from this measurement."""
+    window = PoseWindow(
+        int(row.window_id), region_index,
+        tuple(int(v) for v in row.window_origin_yx_px),
+        tuple(int(v) for v in row.window_shape_yx_cells),
+        int(row.window_depth), 0)
+    pose = AffinePose(
+        tuple(float(v) for v in row.lane_pose_origin_yx),
+        ((float(row.lane_pose_jacobian[0]), float(row.lane_pose_jacobian[1])),
+         (float(row.lane_pose_jacobian[2]), float(row.lane_pose_jacobian[3]))),
+        tuple(float(v) for v in row.lane_pose_phase_yx),
+        float(row.lane_pose_pitch_px), float(row.lane_pose_angle_deg))
+    return PoseSegment(
+        window, pose, int(row.segment_support_cells),
+        float(row.segment_phase_contrast),
+        tuple(float(v) for v in row.segment_pitch_yx_px),
+        float(row.segment_orthogonality_error_deg))
+
+
+@dataclass
+class LaneReconstruction:
+    lane_id: str
+    observations_by_pose: dict[str, tuple[PilotObservation, ...]]
+    n_accepted: int
+    n_reconstructed: int
+    n_refused: int
+
+
+def reconstruct_lane(state: SessionState, raster: Raster, spec: FormatSpec,
+                     capture_sha: str, lane_id: str, *,
+                     config: PlacementConfig = PlacementConfig(),
+                     ) -> LaneReconstruction:
+    """Re-derive one lane's committed-pose pilot reads from durable
+    geometry alone. See the module docstring for the recipe and why it
+    is safe to trust (it is v1's own committed-pose re-derivation, ``
+    place_committed``/``_committed_patch``, extended by the one call that
+    function deliberately omits)."""
+    provider = V1ReferenceField(spec)
+    backing = platen_backing(raster)
+    prefix = f"{capture_sha}/{lane_id}/"
+    regions = [r for r in state.regions if r.region_id.startswith(prefix)]
+    by_index: dict[int, object] = {}
+    for region in regions:
+        by_index[int(region.region_id.rsplit("region-", 1)[1])] = region
+    region_index_by_id = {region.region_id: idx
+                          for idx, region in by_index.items()}
+    poses = [p for p in state.poses
+             if p.capture_id == capture_sha and p.lane_id == lane_id
+             and p.placement_outcome == "accepted"]
+    poses_by_region: dict[int, list[PoseRecord]] = {}
+    for row in poses:
+        idx = region_index_by_id.get(row.region_id)
+        if idx is None:
+            raise ValueError(
+                f"pose {row.pose_id} names region {row.region_id!r}, "
+                f"not found among this lane's durable regions")
+        poses_by_region.setdefault(idx, []).append(row)
+    pitch = (float(np.median([p.lane_pose_pitch_px for p in poses]))
+             if poses else 0.0)
+
+    observations: dict[str, tuple[PilotObservation, ...]] = {}
+    n_refused = 0
+    for region_index, region_poses in poses_by_region.items():
+        ctx = prepare_region(
+            raster, region_from_record(by_index[region_index]),
+            region_index, pitch, config=config, backing=backing)
+        if ctx is None:
+            n_refused += len(region_poses)
+            continue
+        for row in region_poses:
+            segment = _pose_segment(row, region_index)
+            sample = sample_segment(ctx, segment)
+            if sample is None or int(sample.mask.sum()) < HISTORICAL_MIN_SUPPORT:
+                n_refused += 1
+                continue
+            patch = make_address_patch(
+                sample, _core(sample.mask, config.erode_cells))
+            origin = tuple(int(v) for v in row.cell_origin_yx)
+            audited, refused, _, _ = audit_segment(
+                sample, patch.mask, provider, int(row.page), origin,
+                int(row.rot90), config, min_support=HISTORICAL_MIN_SUPPORT)
+            if refused:
+                n_refused += 1
+                continue
+            observations[row.pose_id] = observations_for_segment(
+                sample, audited, provider, int(row.page), origin,
+                int(row.rot90), scan_id=capture_sha,
+                patch_id=int(row.patch_id))
+    return LaneReconstruction(
+        lane_id=lane_id, observations_by_pose=observations,
+        n_accepted=len(poses), n_reconstructed=len(observations),
+        n_refused=n_refused)
+
+
+@dataclass(frozen=True)
+class TileVerdict:
+    tile: TileKey
+    pooled_erasures: int
+    pooled_decoded: int | None
+    pooled_certified: bool
+    pooled_conflict: bool
+    per_pose_erasures: tuple[int, ...]
+    per_pose_decoded: tuple[int | None, ...]
+    any_per_pose_certified: bool
+    any_per_pose_conflict: bool
+
+
+def compare_pooled_vs_per_pose(
+        observations_by_pose: dict[str, tuple[PilotObservation, ...]],
+        spec: FormatSpec) -> tuple[TileVerdict, ...]:
+    """v1-style POOLED reduction (union of every covering pose's reads,
+    ``known_position_words`` called once) against holo2-style PER-POSE
+    reduction (one pose's own reads alone, one call per pose), tile by
+    tile — DIVERGENCE-LEDGER row 19's own recipe. Pure: no state, no
+    raster, no I/O; the oracle test drives this directly on hand-built
+    ``PilotObservation`` tuples.
+    """
+    pooled_all = tuple(
+        obs for pose_obs in observations_by_pose.values() for obs in pose_obs)
+    pooled_words = {(w.page, *w.tile_yx): w
+                    for w in known_position_words(pooled_all, spec)}
+
+    per_pose_words: dict[str, dict[TileKey, KnownWord]] = {}
+    for pose_id, obs in observations_by_pose.items():
+        per_pose_words[pose_id] = {
+            (w.page, *w.tile_yx): w for w in known_position_words(obs, spec)}
+
+    rows = []
+    for tile in sorted(pooled_words):
+        pooled = pooled_words[tile]
+        contributing = sorted(pose_id for pose_id, words
+                              in per_pose_words.items() if tile in words)
+        per_pose = [per_pose_words[pose_id][tile] for pose_id in contributing]
+        rows.append(TileVerdict(
+            tile=tile, pooled_erasures=pooled.erasures,
+            pooled_decoded=pooled.decoded_counter,
+            pooled_certified=pooled.certified,
+            pooled_conflict=pooled.conflict,
+            per_pose_erasures=tuple(w.erasures for w in per_pose),
+            per_pose_decoded=tuple(w.decoded_counter for w in per_pose),
+            any_per_pose_certified=any(w.certified for w in per_pose),
+            any_per_pose_conflict=any(w.conflict for w in per_pose)))
+    return tuple(rows)
+
+
+@dataclass(frozen=True)
+class ComparisonSummary:
+    n_tiles: int
+    n_multi_pose_tiles: int
+    n_pooled_only_certified: int
+    n_per_pose_only_certified: int
+    n_pooled_only_conflict: int
+    n_per_pose_only_conflict: int
+    n_erasures_reduced_by_pooling: int
+
+
+def summarize(rows: tuple[TileVerdict, ...]) -> ComparisonSummary:
+    """Pure tally over :func:`compare_pooled_vs_per_pose`'s output."""
+    n_multi = sum(1 for r in rows if len(r.per_pose_erasures) > 1)
+    n_pooled_only_cert = sum(
+        1 for r in rows if r.pooled_certified and not r.any_per_pose_certified)
+    n_per_pose_only_cert = sum(
+        1 for r in rows if r.any_per_pose_certified and not r.pooled_certified)
+    n_pooled_only_conflict = sum(
+        1 for r in rows if r.pooled_conflict and not r.any_per_pose_conflict)
+    n_per_pose_only_conflict = sum(
+        1 for r in rows if r.any_per_pose_conflict and not r.pooled_conflict)
+    n_reduced = sum(
+        1 for r in rows
+        if r.per_pose_erasures and r.pooled_erasures < min(r.per_pose_erasures))
+    return ComparisonSummary(
+        n_tiles=len(rows), n_multi_pose_tiles=n_multi,
+        n_pooled_only_certified=n_pooled_only_cert,
+        n_per_pose_only_certified=n_per_pose_only_cert,
+        n_pooled_only_conflict=n_pooled_only_conflict,
+        n_per_pose_only_conflict=n_per_pose_only_conflict,
+        n_erasures_reduced_by_pooling=n_reduced)
+
+
+@dataclass
+class F8Report:
+    label: str
+    lane_id: str
+    n_accepted_poses: int
+    n_reconstructed_poses: int
+    n_refused_poses: int
+    durable_bch_conflicts_this_level: int | None
+    summary: ComparisonSummary
+    differing_tiles: tuple[TileVerdict, ...]
+
+
+def f8_report(label: str, v1_state_path: Path, scan_path: Path,
+             scan_dpi: float, *, format_ref: str = DEFAULT_FORMAT,
+             lane_id: str = DEFAULT_LANE) -> F8Report:
+    """(b)'s per-sheet driver: load, reconstruct, compare, validate."""
+    state = load_session(v1_state_path)
+    spec = resolve_format_ref(format_ref)
+    raster = open_capture(scan_path, scan_dpi)
+    capture = next(c for c in state.captures
+                   if c.source_sha256 == raster.source_sha256)
+    reconstruction = reconstruct_lane(state, raster, spec,
+                                      capture.source_sha256, lane_id)
+    rows = compare_pooled_vs_per_pose(
+        reconstruction.observations_by_pose, spec)
+    summary = summarize(rows)
+    differing = tuple(
+        r for r in rows
+        if r.pooled_certified != r.any_per_pose_certified
+        or r.pooled_conflict != r.any_per_pose_conflict)
+
+    durable_conflicts = None
+    for lane, level in zip(capture.plan, capture.levels):
+        if lane.lane_id == lane_id and level.address is not None:
+            durable_conflicts = len(level.address.bch_conflicts)
+            break
+
+    return F8Report(
+        label=label, lane_id=lane_id,
+        n_accepted_poses=reconstruction.n_accepted,
+        n_reconstructed_poses=reconstruction.n_reconstructed,
+        n_refused_poses=reconstruction.n_refused,
+        durable_bch_conflicts_this_level=durable_conflicts,
+        summary=summary, differing_tiles=differing)
+
+
+# =========================================================================
+# rendering + CLI
+# =========================================================================
+
+
+def _render_f6(census: F6Census) -> list[str]:
+    lines = [f"## F6 (row 15) — {census.label}", "",
+             f"- retained losers: **{census.n_losers}** "
+             f"(proposals: {census.n_proposals})",
+             f"- gap cross-reference available: {census.has_gap_cross_reference}"]
+    if census.has_gap_cross_reference:
+        lines.append(
+            f"- losers with a v1-only gap tile within "
+            f"{NEIGHBOR_RADIUS_TILES} tiles: **{census.n_relevant}**"
+            f" of {census.n_losers}")
+    lines.append("")
+    for row in census.rows:
+        lines.append(
+            f"  - `{row.hypothesis_id}` (lane `{row.lane_id}`) anchors "
+            f"tile {row.tile}: v1-certified={row.v1_certified_at_anchor}, "
+            f"holo2-certified={row.h2_certified_at_anchor}, "
+            f"nearby v1-only gap tiles={list(row.nearby_v1_only_gap_tiles)}")
+    lines.append("")
+    return lines
+
+
+def _render_f8(report: F8Report) -> list[str]:
+    s = report.summary
+    lines = [f"## F8 (row 19) — {report.label} (lane `{report.lane_id}`)", "",
+             f"- accepted poses: {report.n_accepted_poses}, "
+             f"reconstructed: {report.n_reconstructed_poses}, "
+             f"refused: {report.n_refused_poses}",
+             f"- durable bch_conflicts on this level (ground truth): "
+             f"{report.durable_bch_conflicts_this_level}",
+             f"- tiles reached: {s.n_tiles} "
+             f"({s.n_multi_pose_tiles} covered by >1 pose)",
+             f"- pooled certifies, no single pose does: "
+             f"{s.n_pooled_only_certified}",
+             f"- a single pose certifies, pooled does not: "
+             f"{s.n_per_pose_only_certified}",
+             f"- pooled conflicts, no single pose does: "
+             f"{s.n_pooled_only_conflict}",
+             f"- a single pose conflicts, pooled does not: "
+             f"{s.n_per_pose_only_conflict}",
+             f"- tiles where pooling strictly reduced erasures: "
+             f"{s.n_erasures_reduced_by_pooling}",
+             f"- differing-verdict tiles: {len(report.differing_tiles)}", ""]
+    for row in report.differing_tiles:
+        lines.append(
+            f"  - tile {row.tile}: pooled(erasures={row.pooled_erasures}, "
+            f"decoded={row.pooled_decoded}, certified={row.pooled_certified}, "
+            f"conflict={row.pooled_conflict}) vs per-pose(erasures="
+            f"{list(row.per_pose_erasures)}, decoded="
+            f"{list(row.per_pose_decoded)}, any_certified="
+            f"{row.any_per_pose_certified}, any_conflict="
+            f"{row.any_per_pose_conflict})")
+    lines.append("")
+    return lines
+
+
+def main(argv: list[str] | None = None) -> int:
+    corpus = Path("<repo>")
+    catchup = _ROOT / "scratch/holo2-catchup"
+    f6_sheets = {
+        "e029": dict(
+            v1_state_path=corpus / "scratch/e028"
+                          / "holo-c2-r0700-q07-ink-counting/receive.state",
+            h2_state_dir=catchup / "real/parity-F2/h2-e029"),
+        "xerox": dict(
+            v1_state_path=corpus
+                          / "scratch/in/holo-xerox-c2-counting-receive.state",
+            h2_state_dir=catchup / "real/parity-F2/h2-xerox"),
+        "demo9": dict(
+            v1_state_path=corpus / "build/demo/receive-v1.state",
+            h2_state_dir=None),
+    }
+    f8_sheets = {
+        "e029": dict(
+            v1_state_path=corpus / "scratch/e028"
+                          / "holo-c2-r0700-q07-ink-counting/receive.state",
+            scan_path=corpus / "scratch/e028/hp-canon-c2-ink-counting.tiff",
+            scan_dpi=4800.0),
+        "xerox": dict(
+            v1_state_path=corpus
+                          / "scratch/in/holo-xerox-c2-counting-receive.state",
+            scan_path=corpus / "scratch/in/xerox-canon-c2-bw.tiff",
+            scan_dpi=4800.0),
+    }
+
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("check", choices=("f6", "f8", "all"))
+    parser.add_argument("--sheet", action="append", default=[],
+                        help="restrict to these labels (default: all "
+                             "declared for the chosen check)")
+    parser.add_argument("--out", type=Path, default=None)
+    args = parser.parse_args(argv)
+
+    lines = [f"# F6/F8 discriminating counts — M3 ({time.strftime('%Y-%m-%d')})",
+            ""]
+    if args.check in ("f6", "all"):
+        labels = args.sheet or list(f6_sheets)
+        for label in labels:
+            print(f"f6_f8_counts: F6 {label} …", file=sys.stderr)
+            census = f6_report(label, **f6_sheets[label])
+            lines.extend(_render_f6(census))
+    if args.check in ("f8", "all"):
+        labels = args.sheet or list(f8_sheets)
+        for label in labels:
+            print(f"f6_f8_counts: F8 {label} (this resamples a real "
+                 f"sheet's pixels; several minutes) …", file=sys.stderr)
+            report = f8_report(label, **f8_sheets[label])
+            lines.extend(_render_f8(report))
+
+    text = "\n".join(lines)
+    print(text)
+    if args.out is not None:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(text, encoding="utf-8")
+        print(f"\nwrote {args.out}", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/holo2_oracles/test_oracle_f6_f8_counts.py b/tests/holo2_oracles/test_oracle_f6_f8_counts.py
