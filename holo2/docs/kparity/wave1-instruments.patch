index 0000000..df82d1c
--- /dev/null
+++ b/tests/holo2_oracles/test_oracle_replay_calibration.py
@@ -0,0 +1,155 @@
+"""Ledger row 53 — RF1's calibration source, PINNED cross-tree.
+
+v1's ``certified_refine._calibration(window)`` rebuilds a
+``detect.Calibration`` straight from the window's RETAINED fields
+(``calibration_score_nodes``, ``calibration_probability_nodes``,
+``n_search`` — carried on ``WindowEvidence`` since generation zero).
+holo2 keeps no such field: ``refine.replay_calibration`` reads the
+stored knots/probabilities back off a frozen ``CalibrationRecord`` blob
+and RECONSTRUCTS ``n_search`` from the probabilities' own tightest bound
+(its docstring: "``Calibration.llr`` never reads it, so every legal
+choice gives bit-identical logits and this one is merely the one that
+always constructs"). Row 53: "Argument only. Named because rows 5 and
+12 both read through it" — discriminating measurement: "assert
+``Calibration.llr`` equality over the stored knots for one archived
+window at several ``n_search`` values."
+
+This file fits ONE real window (``_e023c_fixtures.py``'s proven
+``_segment_fixture`` builder — the same real-shaped fixture row 52's
+oracle uses), pulls v1's own retained ``n_search`` off it, calls v1's
+``_calibration`` directly, and separately drives holo2's
+``replay_calibration`` off a minimal plane double holding the SAME
+knots/probabilities — then checks BOTH the reconstructed value (does
+holo2's replay actually reproduce v1's live window) and the "n_search
+is inert" claim (a battery of n_search values astride the reconstructed
+one, on BOTH trees' ``Calibration``, all giving the identical ``.llr``).
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F). ``_e023c_fixtures.py`` (``tests/holo/``) is a non-test helper
+module, reused via a ``sys.path`` preamble — see
+``test_oracle_segment_labels.py`` for the identical pattern.
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``holo2/src/holo2/solve/refine.py``'s ``replay_calibration`` with
+``knots, probabilities = params[0], params[1]`` swapped to
+``params[1], params[0]`` — ``test_replay_matches_v1_calibration`` failed
+(``.llr`` over the fixture's real scores no longer agreed), and passed
+again after the revert. Not committed here; reproduce by editing a
+checked-out copy of ``refine.py`` and re-running this file.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+_ROOT = Path(__file__).resolve().parent.parent.parent
+_HOLO_TESTS = _ROOT / "tests" / "holo"
+if str(_HOLO_TESTS) not in sys.path:
+    sys.path.insert(0, str(_HOLO_TESTS))
+
+from _e023c_fixtures import _page_fixture, _segment_fixture  # noqa: E402
+
+from holo.receive.certified_refine import _calibration as v1_calibration  # noqa: E402
+from holo.receive import detect as h1detect                     # noqa: E402
+
+from holo2.core import BlobRef, ResourceKey                    # noqa: E402
+from holo2.solve.records import CalibrationRecord, HeldoutGate  # noqa: E402
+from holo2.solve.refine import replay_calibration as h2_replay_calibration  # noqa: E402
+from holo2.solve import detect as h2detect                      # noqa: E402
+
+
+class _Plane:
+    """The two reads ``replay_calibration`` makes of a ``PlaneView``."""
+
+    def __init__(self, record, array: np.ndarray) -> None:
+        self._record = record
+        self._array = array
+
+    def record(self, key):
+        return self._record
+
+    def read_array(self, ref):
+        return self._array
+
+
+@pytest.fixture(scope="module")
+def window():
+    """One real refined window (``_segment_fixture`` fits a real PAVA
+    calibration off real sampled means — the same builder row 52's
+    oracle uses)."""
+    page = _page_fixture()
+    return _segment_fixture(page, window_id=7, region_index=0).request.generation0
+
+
+def test_replay_matches_v1_calibration(window) -> None:
+    v1_calib = v1_calibration(window)
+    knots = np.asarray(window.calibration_score_nodes, np.float64)
+    probabilities = np.asarray(window.calibration_probability_nodes, np.float64)
+    params = np.stack((knots, probabilities))
+    plane = _Plane(
+        CalibrationRecord(
+            scope=ResourceKey("window", ("row53",)), algorithm="pava-v1",
+            params_ref=BlobRef("aa" * 32, params.nbytes),
+            heldout=HeldoutGate(adopted=True, logloss_delta=0.0)),
+        params)
+    h2_calib = h2_replay_calibration(
+        plane, ResourceKey("window", ("row53",)),
+        ResourceKey("calibration", ("row53",)))
+    assert h2_calib is not None
+
+    scores = window.scores
+    assert np.array_equal(v1_calib.llr(scores), h2_calib.llr(scores))
+    assert np.array_equal(
+        v1_calib.probability(scores), h2_calib.probability(scores))
+
+
+def test_replay_returns_none_off_a_foreign_or_malformed_record(window) -> None:
+    """The two documented refusal shapes: not a ``CalibrationRecord``,
+    and a degenerate params blob (``edge <= 0`` — every probability
+    pinned to 0 or 1, admitting no valid n_search)."""
+    key = ResourceKey("window", ("row53",))
+    calib_key = ResourceKey("calibration", ("row53",))
+    assert h2_replay_calibration(_Plane(None, np.zeros((2, 1))),
+                                 key, calib_key) is None
+    degenerate = np.array([[0.0, 1.0], [0.0, 1.0]])
+    record = CalibrationRecord(
+        scope=key, algorithm="pava-v1",
+        params_ref=BlobRef("bb" * 32, degenerate.nbytes),
+        heldout=HeldoutGate(adopted=True, logloss_delta=0.0))
+    assert h2_replay_calibration(_Plane(record, degenerate),
+                                 key, calib_key) is None
+
+
+def test_llr_is_invariant_to_n_search_on_both_trees(window) -> None:
+    """The claim ``replay_calibration``'s docstring makes: any n_search
+    admitting the stored probabilities gives bit-identical ``.llr`` —
+    checked directly on BOTH trees' ``Calibration``, not assumed from
+    one reconstruction."""
+    knots = np.asarray(window.calibration_score_nodes, np.float64)
+    probabilities = np.asarray(window.calibration_probability_nodes, np.float64)
+    edge = float(min(probabilities.min(), 1.0 - probabilities.max()))
+    assert edge > 0.0, "fixture assumption: a non-degenerate PAVA fit"
+    floor_n = max(1, int(np.ceil(1.0 / edge)) - 2)
+    while floor_n > 1 and 1.0 / (floor_n + 2.0) > edge:
+        floor_n += 1
+    candidates = sorted({floor_n, floor_n + 1, floor_n + 5, floor_n + 50,
+                        window.n_search})
+    scores = window.scores
+
+    v1_reference = None
+    h2_reference = None
+    for n_search in candidates:
+        v1_calib = h1detect.Calibration(
+            "row53-n-search", knots, probabilities, n_search)
+        h2_calib = h2detect.Calibration(
+            "row53-n-search", knots, probabilities, n_search)
+        if v1_reference is None:
+            v1_reference, h2_reference = v1_calib.llr(scores), h2_calib.llr(scores)
+        else:
+            assert np.array_equal(v1_calib.llr(scores), v1_reference)
+            assert np.array_equal(h2_calib.llr(scores), h2_reference)
+        assert np.array_equal(v1_calib.llr(scores), h2_calib.llr(scores))
diff --git a/tests/holo2_oracles/test_oracle_segment_labels.py b/tests/holo2_oracles/test_oracle_segment_labels.py
