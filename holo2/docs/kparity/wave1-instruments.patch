index 0000000..279e8b1
--- /dev/null
+++ b/tests/holo2_oracles/test_oracle_cold_search.py
@@ -0,0 +1,409 @@
+"""Ledger row 37 — the cold correlation lane, PINNED cross-tree.
+
+``holo2/src/holo2/solve/cold.py`` is a declared REFACTORED port of
+``src/holo/receive/placement/search.py``'s cold-correlation half (R4:
+"the code is holo2's own, the arithmetic is v1's to the bit" — see
+``cold.py``'s own module docstring, which cites the exact v1 line ranges
+it ported). ``holo2/tests/solve/test_cold.py`` pins that arithmetic
+against a *direct* ``fftconvolve`` call, which is the right contract for
+"is the cached-transform trick exact" but proves nothing about "does this
+port still compute what v1 computes" — its own docstring says so
+verbatim: *"The cross-tree differential against src/holo's own
+correlate_patch is a scratch instrument, not a committed test — the
+firewall keeps holo imports out of this tree."*
+
+Searched for: no such scratch differential exists anywhere under
+``scratch/holo2-catchup/`` (2026-08-28) — ``C2-placement.md:159`` records
+only that PARITY-MATRIX row 47 calls the port "NOT cross-tree pinned".
+This file is that promotion: v1's ``_cold_map_geometries``,
+``_signed_search_field``, ``_page_candidate_map`` and ``correlate_patch``
+run side by side with holo2's namesakes on ONE shared fixture, and every
+observable is byte-compared — the geometry fields, the candidate maps,
+and the full ``SearchOutcome``.
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F). The provider/patch/scorer doubles are the ``holo2/tests/solve/
+test_cold.py`` shapes, widened by ONE field (``_Spec.layout``) so a
+single object satisfies both trees' duck-typed reads — v1's
+``provider.spec.layout.cells_yx`` and holo2's ``provider.spec.cells_yx``
+(``cold.py``'s own docstring names this exact seam: "v1 read the page
+extent as ``provider.spec.layout.cells_yx``; holo2's ``TileFormat`` has
+no ``layout`` nesting, so this module reads ``provider.spec.cells_yx``").
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``holo2/src/holo2/solve/cold.py`` with ``np.rint`` swapped for
+``np.floor`` in the eligibility floor (mirrors ``test_cold.py``'s own
+"truncation would move it" fixture) — ``test_correlate_patch_agrees``
+failed with a mismatched ``accepted``/``best`` on the perturbed tree, and
+passed again after the revert. Not committed here (no mutation belongs
+in a pin); reproduce by editing a checked-out copy of ``cold.py`` and
+re-running this file.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pytest
+
+import holo2.solve.cold as h2cold
+from holo2.solve.place_model import (
+    AttemptBudget, CandidateScore as H2CandidateScore, PlacementConfig)
+from holo2.solve.pose_audit import parity_mask as h2_parity_mask
+
+import holo.receive.placement.search as h1search
+from holo.receive.placement.model import (
+    AttemptBudget as H1AttemptBudget,
+    CandidateScore as H1CandidateScore,
+    PlacementConfig as H1PlacementConfig)
+
+PAGE_SHAPE = (24, 30)
+
+# max_hypotheses 100,000 -> identifiability floor 28, so min_support is
+# E022's carried 30 (place_model's max(...) picks the larger) — the same
+# fixture constant ``test_cold.py`` uses, so both budgets compute the
+# identical floor independently on each tree.
+H2_BUDGET = AttemptBudget(
+    max_hypotheses=100_000, familywise_false_accept=1e-3,
+    max_true_error_rate=0.08,
+    qualification_id="holo2/tests/oracle/cold-search-parity")
+H1_BUDGET = H1AttemptBudget(
+    max_hypotheses=100_000, familywise_false_accept=1e-3,
+    max_true_error_rate=0.08,
+    qualification_id="holo2/tests/oracle/cold-search-parity")
+
+
+# ------------------------------------------------------------- the doubles
+
+@dataclass(frozen=True)
+class _Page:
+    values: np.ndarray
+    sites: np.ndarray
+
+
+@dataclass(frozen=True)
+class _Layout:
+    cells_yx: tuple[int, int]
+
+
+@dataclass(frozen=True)
+class _Spec:
+    """Satisfies BOTH trees' provider.spec reads (see module docstring)."""
+
+    cells_yx: tuple[int, int]
+
+    @property
+    def layout(self) -> _Layout:
+        return _Layout(self.cells_yx)
+
+
+class _Provider:
+    """One object usable as both a v1 ``ReferenceFieldProvider`` and a
+    holo2 one — same page/site content, read through each tree's own
+    attribute path."""
+
+    def __init__(self, values_by_page: list[np.ndarray],
+                 sites_by_page: list[np.ndarray]) -> None:
+        self._pages = [_Page(values, sites) for values, sites
+                       in zip(values_by_page, sites_by_page, strict=True)]
+        shape = self._pages[0].values.shape
+        self.spec = _Spec((int(shape[0]), int(shape[1])))
+
+    def page(self, page: int) -> _Page:
+        return self._pages[int(page)]
+
+
+def _overlap_slices(origin_yx, fragment_shape, page_shape):
+    origin_y, origin_x = origin_yx
+    height, width = page_shape
+    frag_height, frag_width = fragment_shape
+    page_y0, page_x0 = max(0, origin_y), max(0, origin_x)
+    page_y1, page_x1 = (min(height, origin_y + frag_height),
+                        min(width, origin_x + frag_width))
+    if page_y0 >= page_y1 or page_x0 >= page_x1:
+        return None
+    return (slice(page_y0, page_y1), slice(page_x0, page_x1),
+            slice(page_y0 - origin_y, page_y1 - origin_y),
+            slice(page_x0 - origin_x, page_x1 - origin_x))
+
+
+class _Scorer:
+    """v1's parity score, faithfully — used as BOTH trees' ``memo``.
+
+    Field-for-field the ``test_cold.py``/``test_e022_search_exactness``
+    double: ``correlate_patch`` on both sides calls ``memo.parity_score``
+    and ``memo.candidate`` with the identical positional shape, so the
+    same arithmetic serves both call sites. ``candidate_cls`` is the one
+    difference a caller must supply — v1's ``correlate_patch`` reads
+    ``best.page``/``.origin_yx``/``.rot_k`` off its own frozen
+    ``CandidateScore``, so the double must mint the CALLER's class, not a
+    bare tuple, for either tree to run at all.
+    """
+
+    def __init__(self, provider: _Provider, candidate_cls=H2CandidateScore
+                ) -> None:
+        self.provider = provider
+        self._candidate_cls = candidate_cls
+
+    def parity_score(self, sample_key, evidence, bits, mask, page,
+                     origin_yx, rot_k, parity):
+        reference = self.provider._pages[int(page)]
+        observed = np.rot90(np.asarray(evidence, np.float32), rot_k)
+        hard = np.rot90(np.asarray(bits, np.uint8), rot_k)
+        keep = np.rot90(np.asarray(mask, bool), rot_k)
+        slices = _overlap_slices(
+            origin_yx, observed.shape, reference.values.shape)
+        if slices is None:
+            return (1.0, 0, 0, -np.inf)
+        page_y, page_x, frag_y, frag_x = slices
+        selected = reference.sites[page_y, page_x] & keep[frag_y, frag_x]
+        if parity != h2cold.WHOLE_WORD_PARITY:
+            selected = selected & h2_parity_mask(
+                selected.shape,
+                (int(page_y.start or 0), int(page_x.start or 0)), parity)
+        support = int(selected.sum())
+        if support == 0:
+            return (1.0, 0, 0, -np.inf)
+        expected_bits = reference.values[page_y, page_x][selected]
+        observed_evidence = observed[frag_y, frag_x][selected]
+        expected_sign = 1.0 - 2.0 * expected_bits.astype(np.float32)
+        total_weight = float(np.abs(observed_evidence).sum())
+        correlation = float(np.sum(expected_sign * observed_evidence))
+        mismatch = ((total_weight - correlation) / (2.0 * total_weight)
+                    if total_weight > 0.0 else 1.0)
+        errors = int(np.count_nonzero(
+            hard[frag_y, frag_x][selected] != expected_bits))
+        return (float(mismatch), errors, support,
+                float(correlation / np.sqrt(max(total_weight, 1e-9))))
+
+    def candidate(self, sample_key, evidence, bits, mask, page, origin_yx,
+                  rot_k, budget, route):
+        search = self.parity_score(
+            sample_key, evidence, bits, mask, page, origin_yx, rot_k, 0)
+        validation = self.parity_score(
+            sample_key, evidence, bits, mask, page, origin_yx, rot_k, 1)
+        passes = (search[2] >= budget.min_support
+                  and validation[2] >= budget.min_support
+                  and search[0] < budget.gate.search_true
+                  and validation[0] < budget.gate.validation_true)
+        return self._candidate_cls(
+            int(page), (int(origin_yx[0]), int(origin_yx[1])),
+            int(rot_k) % 4, search[0], validation[0], search[1],
+            validation[1], search[2], validation[2], search[3], passes,
+            route)
+
+
+@dataclass(frozen=True)
+class _Patch:
+    evidence: np.ndarray
+    bits: np.ndarray
+    mask: np.ndarray
+
+
+def _patch_from_bits(rng, bits, mask=None):
+    bits = np.ascontiguousarray(bits, np.uint8)
+    amplitude = rng.uniform(0.6, 1.0, bits.shape).astype(np.float32)
+    evidence = ((1.0 - 2.0 * bits.astype(np.float32))
+                * amplitude).astype(np.float32)
+    return _Patch(evidence, bits,
+                  np.ones(bits.shape, bool) if mask is None else mask)
+
+
+def _world(seed, page_count=3, shape=PAGE_SHAPE, density=0.85):
+    rng = np.random.default_rng(seed)
+    sites = rng.random(shape) < density
+    values = [rng.integers(0, 2, shape).astype(np.uint8)
+              for _ in range(page_count)]
+    return rng, sites, values
+
+
+def _provider(values, sites):
+    return _Provider(values, [sites] * len(values))
+
+
+def _true_patch(rng, values, origin_yx, crop_shape, rot_k, flips=0.0):
+    oy, ox = origin_yx
+    crop = values[oy:oy + crop_shape[0], ox:ox + crop_shape[1]].copy()
+    if flips:
+        crop ^= (rng.random(crop.shape) < flips).astype(np.uint8)
+    return _patch_from_bits(rng, np.rot90(crop, -rot_k))
+
+
+def _same(left: np.ndarray, right: np.ndarray) -> bool:
+    return (left.dtype == right.dtype and left.shape == right.shape
+            and bool(np.array_equal(left, right)))
+
+
+# ------------------------------------------------- geometries and z-maps
+
+@pytest.mark.parametrize("allow_overhang", [False, True])
+def test_cold_map_geometries_agree(allow_overhang) -> None:
+    """The four page-invariant geometries, field for field, both trees."""
+    rng, sites, _values = _world(seed=101)
+    patch = _patch_from_bits(
+        rng, rng.integers(0, 2, (12, 16)), mask=rng.random((12, 16)) < 0.95)
+    h1_geoms = h1search._cold_map_geometries(
+        patch.evidence, patch.mask, sites, H1_BUDGET,
+        allow_overhang=allow_overhang)
+    h2_geoms = h2cold._cold_map_geometries(
+        patch.evidence, patch.mask, sites, H2_BUDGET,
+        allow_overhang=allow_overhang)
+    assert len(h1_geoms) == len(h2_geoms) == 4
+    compared = 0
+    for h1g, h2g in zip(h1_geoms, h2_geoms, strict=True):
+        assert (h1g is None) == (h2g is None)
+        if h1g is None:
+            continue
+        assert _same(h1g.work_sites, h2g.work_sites)
+        assert _same(h1g.search_sites, h2g.search_sites)
+        assert _same(h1g.soft_kernel, h2g.soft_kernel)
+        assert _same(h1g.weight, h2g.weight)
+        assert _same(h1g.eligible, h2g.eligible)
+        assert (h1g.pad_y, h1g.pad_x) == (h2g.pad_y, h2g.pad_x)
+        assert h1g.fshape == h2g.fshape
+        assert (h1g.kernel_rfft is None) == (h2g.kernel_rfft is None)
+        if h1g.kernel_rfft is not None:
+            assert _same(h1g.kernel_rfft, h2g.kernel_rfft)
+        compared += 1
+    assert compared > 0
+
+
+def test_page_candidate_maps_agree() -> None:
+    """One page's z map, both trees, over every orientation."""
+    rng, sites, values = _world(seed=103)
+    patch = _patch_from_bits(
+        rng, rng.integers(0, 2, (12, 16)), mask=rng.random((12, 16)) < 0.95)
+    h1_geoms = h1search._cold_map_geometries(
+        patch.evidence, patch.mask, sites, H1_BUDGET, allow_overhang=True)
+    h2_geoms = h2cold._cold_map_geometries(
+        patch.evidence, patch.mask, sites, H2_BUDGET, allow_overhang=True)
+    h1_transforms: dict = {}
+    h2_transforms: dict = {}
+    compared = 0
+    for h1g, h2g in zip(h1_geoms, h2_geoms, strict=True):
+        if h1g is None:
+            continue
+        for page, page_values in enumerate(values):
+            h1z = h1search._page_candidate_map(
+                page_values, h1g, page, h1_transforms)
+            h2z = h2cold._page_candidate_map(
+                page_values, h2g, page, h2_transforms)
+            assert _same(h1z, h2z)
+            compared += 1
+    assert compared > 0
+    # The page-side transform cache: shared across equal-padding maps on
+    # both trees, and by the SAME count (proves the cache key, not just
+    # the values it produces, is unchanged).
+    assert len(h1_transforms) == len(h2_transforms)
+
+
+# -------------------------------------------------- the whole cold search
+
+def _score_tuple(candidate):
+    """A ``CandidateScore``'s twelve fields, as a plain value tuple.
+
+    v1's and holo2's ``CandidateScore`` are two distinct frozen
+    dataclasses (field-for-field identical, per the ``place_model.py``
+    comparison above); their generated ``__eq__`` checks ``__class__``
+    first, so ``h1_candidate == h2_candidate`` is FALSE even when every
+    field agrees. Flattening to a tuple is the actual value comparison.
+    """
+    if candidate is None:
+        return None
+    return (candidate.page, candidate.origin_yx, candidate.rot_k,
+            candidate.search_mismatch, candidate.validation_mismatch,
+            candidate.search_errors, candidate.validation_errors,
+            candidate.search_support, candidate.validation_support,
+            candidate.soft_z, candidate.passes, candidate.route)
+
+
+def _outcome_tuple(outcome):
+    """Every field ``correlate_patch`` may set, flattened for comparison."""
+    return (outcome.accepted,
+            _score_tuple(outcome.best),
+            tuple(_score_tuple(row) for row in outcome.runner_ups),
+            outcome.hypotheses, outcome.reason, outcome.support_floor,
+            _score_tuple(outcome.rival))
+
+
+@pytest.mark.parametrize("rot_k", [0, 1, 2, 3])
+def test_correlate_patch_agrees_accepted(rot_k) -> None:
+    rng, sites, values = _world(seed=53)
+    provider = _provider(values, sites)
+    patch = _true_patch(rng, values[1], (4, 8), (16, 16), rot_k, flips=0.04)
+    h1_outcome = h1search.correlate_patch(
+        patch, provider, (0, 1, 2), H1_BUDGET, _Scorer(provider, H1CandidateScore),
+        sample_key=11, config=H1PlacementConfig())
+    h2_outcome = h2cold.correlate_patch(
+        patch, provider, (0, 1, 2), H2_BUDGET, _Scorer(provider),
+        sample_key=11, config=PlacementConfig())
+    assert _outcome_tuple(h1_outcome) == _outcome_tuple(h2_outcome)
+    assert h1_outcome.accepted and h2_outcome.accepted
+
+
+def test_correlate_patch_agrees_on_a_rival_gap_refusal() -> None:
+    """Two identical placements: the decoy bar refuses on both trees."""
+    rng, sites, values = _world(seed=23)
+    values[2] = values[0].copy()
+    provider = _provider(values, sites)
+    patch = _true_patch(rng, values[0], (4, 8), (16, 16), 0)
+    h1_outcome = h1search.correlate_patch(
+        patch, provider, (2, 0, 1), H1_BUDGET, _Scorer(provider, H1CandidateScore),
+        sample_key=11, config=H1PlacementConfig())
+    h2_outcome = h2cold.correlate_patch(
+        patch, provider, (2, 0, 1), H2_BUDGET, _Scorer(provider),
+        sample_key=11, config=PlacementConfig())
+    assert _outcome_tuple(h1_outcome) == _outcome_tuple(h2_outcome)
+    assert not h1_outcome.accepted
+    assert h1_outcome.reason == "rival_gap_failed"
+
+
+def test_correlate_patch_agrees_on_insufficient_support() -> None:
+    rng, sites, values = _world(seed=41)
+    provider = _provider(values, sites)
+    patch = _true_patch(rng, values[0], (3, 3), (6, 6), 0)
+    h1_outcome = h1search.correlate_patch(
+        patch, provider, (0, 1, 2), H1_BUDGET, _Scorer(provider, H1CandidateScore),
+        sample_key=11, config=H1PlacementConfig())
+    h2_outcome = h2cold.correlate_patch(
+        patch, provider, (0, 1, 2), H2_BUDGET, _Scorer(provider),
+        sample_key=11, config=PlacementConfig())
+    assert _outcome_tuple(h1_outcome) == _outcome_tuple(h2_outcome)
+    assert h1_outcome.reason == "insufficient_support"
+
+
+def test_correlate_patch_agrees_on_an_overhanging_fragment() -> None:
+    rng, sites, values = _world(seed=59)
+    provider = _provider(values, sites)
+    canvas = rng.integers(0, 2, (34, 38)).astype(np.uint8)
+    canvas[5:5 + PAGE_SHAPE[0], 4:4 + PAGE_SHAPE[1]] = values[2]
+    patch = _patch_from_bits(rng, np.rot90(canvas, -2))
+    h1_outcome = h1search.correlate_patch(
+        patch, provider, (0, 1, 2), H1_BUDGET, _Scorer(provider, H1CandidateScore),
+        sample_key=11, config=H1PlacementConfig())
+    h2_outcome = h2cold.correlate_patch(
+        patch, provider, (0, 1, 2), H2_BUDGET, _Scorer(provider),
+        sample_key=11, config=PlacementConfig())
+    assert _outcome_tuple(h1_outcome) == _outcome_tuple(h2_outcome)
+    assert h1_outcome.best is not None
+    assert ((h1_outcome.best.page, h1_outcome.best.origin_yx,
+            h1_outcome.best.rot_k) == (2, (-5, -4), 2))
+
+
+def test_correlate_patch_agrees_on_winners_second_peak_rival() -> None:
+    """An in-page duplicate motif: the winning map's second peak is the
+    rival on both trees, the E022 whole-word decision case row 1/2 lean
+    on staying reproducible from."""
+    rng, sites, values = _world(seed=71)
+    values[0][2:18, 2:18] = values[0][6:22, 12:28]
+    provider = _provider(values, sites)
+    patch = _true_patch(rng, values[0], (6, 12), (16, 16), 0)
+    h1_outcome = h1search.correlate_patch(
+        patch, provider, (0, 1, 2), H1_BUDGET, _Scorer(provider, H1CandidateScore),
+        sample_key=11, config=H1PlacementConfig())
+    h2_outcome = h2cold.correlate_patch(
+        patch, provider, (0, 1, 2), H2_BUDGET, _Scorer(provider),
+        sample_key=11, config=PlacementConfig())
+    assert _outcome_tuple(h1_outcome) == _outcome_tuple(h2_outcome)
+    assert not h1_outcome.accepted and h1_outcome.reason == "rival_gap_failed"
diff --git a/tests/holo2_oracles/test_oracle_footing_raster_bytes.py b/tests/holo2_oracles/test_oracle_footing_raster_bytes.py
new file mode 100644
index 0000000..b08fb02
--- /dev/null
+++ b/tests/holo2_oracles/test_oracle_footing_raster_bytes.py
@@ -0,0 +1,154 @@
+"""Ledger row 45 — one rung's BYTES, PINNED across the two derivation
+wrappers, not just the shared decimation kernel underneath them.
+
+v1 derives a sub-native lane per-LANE, inside ``cascade._derive_level``:
+stream ``scale_space.area_decimate_into`` into a ``TemporaryFile``-backed
+``np.memmap``, wrap it in a ``ScaleRaster``, and read crops through
+``ScaleRaster.crop_luma`` (float32 cast, copy-if-aliased, frozen).
+
+holo2 derives the whole sub-native ladder ONCE at ingest, into a
+content-named file beside the prepared planes: ``write_footing_raster``
+streams the SAME carried ``area_decimate_into`` into a
+``.footing.raw`` memmap, ``open_footing_raster`` maps it read-only, and
+``FootingRaster.crop_luma`` reads crops (float32 cast, copy, frozen —
+the identical contract, independently spelled).
+
+``holo2/tests/holo2_oracles/test_oracle_scale_space.py`` already pins
+``area_decimate``/``area_decimate_into`` itself bit-exact (the shared
+kernel both wrappers call) — DIVERGENCE-LEDGER row 45 is explicit that
+what is UNPINNED is the WRAPPING: naming, memmap construction, dtype
+round-trip and the crop contract around that kernel. This file drives
+BOTH wrappers from the same synthetic native raster and the same exact
+scale, and byte-compares ``crop_luma`` over several windows, including
+the corners.
+
+The ``c1p9_rung_survey.py`` harness the ledger names
+(``scratch/holo2-catchup/v1audit/c1p9_rung_survey.py``) opens an
+ARCHIVED real state to compare against — the worker discipline here
+forbids decoding against or holding an archived state open for anything
+but a single read, and this pin does not need one: the wrapping under
+test is pure function of (native pixels, scale), so a small synthetic
+raster exercises the identical code paths at negligible cost. Its
+``RungRaster`` shape (a ``crop_luma`` read-only view) is the pattern
+this file's holo2 side reuses production code for instead of
+reimplementing.
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F).
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``holo2/src/holo2/capture/footing_raster.py``'s ``FootingRaster.
+crop_luma`` with the float32 cast changed to float64 — every crop
+comparison failed on dtype, and passed again after the revert. Not
+committed here; reproduce by editing a checked-out copy of
+``footing_raster.py`` and re-running this file.
+"""
+from __future__ import annotations
+
+import hashlib
+from fractions import Fraction
+from tempfile import TemporaryFile
+
+import numpy as np
+import pytest
+
+from holo2.capture.footing_raster import (footing_plan, footing_transform,
+                                          open_footing_raster,
+                                          write_footing_raster)
+from holo2.capture.scale_space import AreaPixelTransform as H2Transform
+
+from holo.receive.cascade import ScaleRaster
+from holo.receive.scale_space import (
+    AreaPixelTransform as H1Transform, area_decimate_into)
+
+_SHA = hashlib.sha256(b"row45-footing-raster-oracle").hexdigest()
+
+
+def _native_raster(shape, seed, dtype=np.uint8):
+    rng = np.random.default_rng(seed)
+    if np.issubdtype(dtype, np.integer):
+        info = np.iinfo(dtype)
+        return rng.integers(info.min, info.max, shape, dtype=dtype)
+    return rng.uniform(0.0, 255.0, shape).astype(dtype)
+
+
+def _v1_rung(native: np.ndarray, ratio: Fraction, dpi: float) -> ScaleRaster:
+    """v1's ``cascade._derive_level`` body, K/grey case, verbatim shape:
+    a ``TemporaryFile``-backed memmap streamed by the carried decimation,
+    wrapped in ``ScaleRaster`` — the exact sequence ``_derive_level``
+    runs, minus the ``ScheduleContext``/lane plumbing around it."""
+    transform = H1Transform(ratio)
+    shape = transform.output_shape(native.shape)
+    artifact = TemporaryFile(prefix="row45-oracle-", suffix=".dat")
+    pixels = np.memmap(artifact, mode="w+", dtype=native.dtype, shape=shape)
+    area_decimate_into(native, transform, pixels)
+    return ScaleRaster(pixels, _SHA, dpi)
+
+
+def _h2_rung(native: np.ndarray, native_ppc: Fraction, ppc: Fraction,
+            directory) -> "FootingRaster":  # noqa: F821 (imported below)
+    """holo2's ingest-time write, then the production read-back."""
+    transform = footing_transform(ppc, native_ppc)
+    plan = footing_plan(_SHA, transform, native.shape, native.dtype,
+                        directory=directory)
+    write_footing_raster(native, transform, plan)
+    rung = open_footing_raster(plan, ppc)
+    assert rung is not None, "just-written footing raster did not stand"
+    return rung
+
+
+RATIOS = [Fraction(2), Fraction(3), Fraction(4), Fraction(3, 2),
+         Fraction(5, 2)]
+
+
+@pytest.mark.parametrize("ratio", RATIOS, ids=lambda r: f"{r.numerator}_{r.denominator}")
+@pytest.mark.parametrize("dtype", [np.uint8, np.uint16, np.float32])
+def test_rung_crop_luma_bytes_agree(tmp_path, ratio, dtype) -> None:
+    native = _native_raster((97, 131), seed=45_000 + hash(str(ratio)) % 997,
+                            dtype=dtype)
+    # native_ppc/ppc = ratio: pick native_ppc large enough to keep ppc a
+    # positive rung (the ladder never upsamples, footing_transform's own
+    # guard) whatever ratio is under test.
+    native_ppc = Fraction(24)
+    ppc = native_ppc / ratio
+
+    v1 = _v1_rung(native, ratio, dpi=1200.0)
+    h2 = _h2_rung(native, native_ppc, ppc, tmp_path)
+
+    assert v1.shape == h2.shape
+    height, width = v1.shape
+    crops = [
+        (0, height, 0, width),                       # the whole rung
+        (0, min(5, height), 0, min(5, width)),        # top-left corner
+        (max(0, height - 5), height, max(0, width - 5), width),  # bottom-right
+        (height // 3, height // 3 + 4, width // 4, width // 4 + 6),
+    ]
+    for r0, r1, c0, c1 in crops:
+        if r0 >= r1 or c0 >= c1:
+            continue
+        v1_crop = v1.crop_luma(r0, r1, c0, c1)
+        h2_crop = h2.crop_luma(r0, r1, c0, c1)
+        assert v1_crop.dtype == h2_crop.dtype == np.float32
+        assert v1_crop.shape == h2_crop.shape
+        assert np.array_equal(v1_crop, h2_crop), (
+            f"rung bytes forked at crop ({r0},{r1},{c0},{c1}) dtype={dtype} "
+            f"ratio={ratio}")
+        assert not v1_crop.flags.writeable
+        assert not h2_crop.flags.writeable
+
+
+def test_transform_source_per_output_agrees_with_footing_transform() -> None:
+    """The scale each wrapper's crop is a function of, cross-tree — the
+    fact ``test_oracle_scale_space.py`` pins for the LADDER's transform,
+    restated for the footing-specific constructor row 45 actually
+    drives (``footing_transform``, not ``ScaleSchedule.auto``)."""
+    native_ppc, ppc = Fraction(24), Fraction(9)
+    h1t = H1Transform(native_ppc / ppc)
+    h2t = footing_transform(ppc, native_ppc)
+    assert isinstance(h2t, H2Transform)
+    assert h1t.source_per_output == h2t.source_per_output
+    assert h1t.is_identity == h2t.is_identity
+    assert h1t.is_integer_box == h2t.is_integer_box
+    for shape in ((97, 131), (1024, 768)):
+        assert h1t.output_shape(shape) == h2t.output_shape(shape)
diff --git a/tests/holo2_oracles/test_oracle_predict_from_anchor.py b/tests/holo2_oracles/test_oracle_predict_from_anchor.py
new file mode 100644
index 0000000..4942404
--- /dev/null
+++ b/tests/holo2_oracles/test_oracle_predict_from_anchor.py
@@ -0,0 +1,139 @@
+"""Ledger row 39 — the chain-route affine transport, PINNED cross-tree.
+
+Two independent affine expressions are supposed to compute the SAME
+transport of a target window through an accepted anchor pose:
+
+* v1's ``placement/search.py:785 predict_from_anchor`` (verbatim-carried
+  into holo2 as ``solve/pose_audit.py:373``, but that carry is referenced
+  ONLY by ``holo2/tests/solve/test_pose_audit.py`` — nothing production
+  calls it);
+* holo2's PRODUCTION chain route, ``place_shared.py``'s
+  ``page_affine_terms`` (v1's anchor pose turned into a durable six-term
+  page-cell -> native-pixel affine) composed with
+  ``predict_from_page_affine`` (that affine run backwards for a NEW
+  target window) — ``place_shared.WindowJob._search`` is what a real
+  chain fire calls.
+
+``place_shared.page_affine_terms``'s own docstring makes the equivalence
+claim in prose (C2 §4: "all three maps identical term for term") but,
+per the DIVERGENCE-LEDGER, nothing pins it. This file is that pin: for a
+battery of anchor/target poses and every ``rot_k``, assert
+
+    predict_from_page_affine(page_affine_terms(anchor, ...), target, ...)
+        == (rot_k, predict_from_anchor(anchor, ..., rot_k, target, ...))
+
+Two conventions differ by design (documented in both docstrings, not
+divergences): holo2's page affine maps cell EDGES where v1's maps cell
+CENTRES (an explicit ``-A @ (0.5, 0.5)`` term), and
+``predict_from_page_affine`` RECOVERS ``rot_k`` by exact argmin over the
+four rot90 candidates rather than taking it as an argument — so this
+file also pins that the recovered ``rot_k`` is always the one that went
+in.
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F).
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``place_shared.page_affine_terms`` with the cell-edge offset term
+(``- linear @ np.full(2, 0.5)``) deleted — every case in
+``test_predict_from_page_affine_matches_predict_from_anchor`` failed
+(origin off by round(0.5 cell) in native pixels), and passed again after
+the revert. Not committed here; reproduce by editing a checked-out copy
+of ``place_shared.py`` and re-running this file.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from holo2.solve.place_model import AffinePose as H2AffinePose
+from holo2.solve.place_shared import page_affine_terms, predict_from_page_affine
+
+from holo.receive.placement.model import AffinePose as H1AffinePose
+from holo.receive.placement.search import predict_from_anchor as h1_predict
+
+
+def _pose(cls, origin_yx, pitch, angle_rad):
+    """A valid ``AffinePose`` at ``pitch`` px/cell, rotated ``angle_rad``."""
+    cos_a, sin_a = np.cos(angle_rad), np.sin(angle_rad)
+    jacobian = (
+        (pitch * cos_a, -pitch * sin_a),
+        (pitch * sin_a, pitch * cos_a),
+    )
+    return cls(origin_yx, jacobian, (0.5, 0.5), pitch,
+              float(np.degrees(angle_rad)))
+
+
+def _battery(seed: int, count: int):
+    """Anchor/target pose pairs plus shape/origin facts, both trees'."""
+    rng = np.random.default_rng(seed)
+    for _ in range(count):
+        anchor_origin = tuple(rng.uniform(-50.0, 800.0, 2))
+        anchor_pitch = float(rng.uniform(6.0, 20.0))
+        anchor_angle = float(rng.uniform(-0.05, 0.05))
+        target_origin = tuple(rng.uniform(-50.0, 800.0, 2))
+        target_pitch = float(rng.uniform(6.0, 20.0))
+        target_angle = float(rng.uniform(-0.05, 0.05))
+        anchor_shape = (int(rng.integers(20, 220)), int(rng.integers(20, 220)))
+        target_shape = (int(rng.integers(20, 220)), int(rng.integers(20, 220)))
+        page_origin_yx = (int(rng.integers(-100, 2000)),
+                          int(rng.integers(-100, 2000)))
+        yield dict(
+            anchor_origin=anchor_origin, anchor_pitch=anchor_pitch,
+            anchor_angle=anchor_angle, target_origin=target_origin,
+            target_pitch=target_pitch, target_angle=target_angle,
+            anchor_shape=anchor_shape, target_shape=target_shape,
+            page_origin_yx=page_origin_yx)
+
+
+CASES = list(_battery(seed=2026_08_28, count=12))
+
+
+@pytest.mark.parametrize("case", CASES,
+                         ids=[f"case{i}" for i in range(len(CASES))])
+@pytest.mark.parametrize("rot_k", [0, 1, 2, 3])
+def test_predict_from_page_affine_matches_predict_from_anchor(
+        case, rot_k) -> None:
+    h1_anchor = _pose(H1AffinePose, case["anchor_origin"],
+                      case["anchor_pitch"], case["anchor_angle"])
+    h1_target = _pose(H1AffinePose, case["target_origin"],
+                      case["target_pitch"], case["target_angle"])
+    h2_anchor = _pose(H2AffinePose, case["anchor_origin"],
+                      case["anchor_pitch"], case["anchor_angle"])
+    h2_target = _pose(H2AffinePose, case["target_origin"],
+                      case["target_pitch"], case["target_angle"])
+
+    v1_origin = h1_predict(
+        h1_anchor, case["anchor_shape"], case["page_origin_yx"], rot_k,
+        h1_target, case["target_shape"])
+
+    terms = page_affine_terms(
+        h2_anchor, case["anchor_shape"], rot_k, case["page_origin_yx"])
+    recovered_rot_k, h2_origin = predict_from_page_affine(
+        terms, h2_target, case["target_shape"])
+
+    assert recovered_rot_k == rot_k, (
+        "predict_from_page_affine must recover the rot_k that built the "
+        "page affine, or the argmin over the four rot90 candidates has "
+        "moved")
+    assert h2_origin == v1_origin, (
+        f"page-affine transport {h2_origin} != v1's predict_from_anchor "
+        f"{v1_origin} at rot_k={rot_k}, case={case}")
+
+
+def test_native_frame_default_matches_the_identity_composition() -> None:
+    """``frame=None`` (every K call today) is the native-rung identity —
+    named explicitly because the H4-LANES rung composition
+    (``compose_to_native``/``compose_from_native``) is a SEPARATE claim
+    this file does not exercise; a caller that started passing a frame
+    would silently leave this pin's coverage without this check."""
+    case = CASES[0]
+    h2_anchor = _pose(H2AffinePose, case["anchor_origin"],
+                      case["anchor_pitch"], case["anchor_angle"])
+    terms_default = page_affine_terms(
+        h2_anchor, case["anchor_shape"], 1, case["page_origin_yx"])
+    terms_explicit_none = page_affine_terms(
+        h2_anchor, case["anchor_shape"], 1, case["page_origin_yx"],
+        frame=None)
+    assert terms_default == terms_explicit_none
diff --git a/tests/holo2_oracles/test_oracle_region_from_record.py b/tests/holo2_oracles/test_oracle_region_from_record.py
new file mode 100644
index 0000000..3499a15
--- /dev/null
+++ b/tests/holo2_oracles/test_oracle_region_from_record.py
@@ -0,0 +1,128 @@
+"""Ledger row 46 — rebuilding a durable survey region, PINNED cross-tree.
+
+v1's ``survey.region_from_record`` rebuilds a transient ``SurveyRegion``
+from an RLE-encoded ``SurveyRegionRecord`` (row-major true-runs over a
+grid). holo2's ``capture.catalog.region_from_record`` rebuilds the SAME
+role's ``RegionCandidate`` from a ``RegionRecord`` plus a separately
+unpacked mask array (the blob format differs — a content-addressed array
+blob vs RLE runs — but the ``SupportMask`` both sides reconstruct is the
+CARRIED, identical dataclass). Row 46: "Same role, different record
+type; nothing compares the two rebuilds." Discriminating measurement:
+"rebuild ONE archived region both ways and byte-compare
+``SupportMask.cells``, ``bbox``, ``area_mm2``."
+
+This file builds one random support grid, encodes it BOTH ways (v1's
+RLE runs, holo2's raw mask array) into each tree's own record type,
+calls each tree's ``region_from_record``, and compares the rebuilt
+``SupportMask`` (cells/origin/step/extent), the bbox, and the area —
+holo2's ``area_mm2`` is RECOMPUTED fresh from the rebuilt support
+(``support.area_px / (dpi/25.4)**2``), while v1's is read verbatim off
+the record, so this file stores the SAME formula's output in v1's
+record rather than an arbitrary number, and the comparison is then a
+real equivalence check, not two unrelated inputs.
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F).
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``holo2/src/holo2/capture/catalog.py``'s ``region_from_record`` with
+``bbox_px=support.bbox`` changed to read a stale field left over from an
+earlier support object — ``test_rebuilt_region_agrees`` failed on the
+bbox comparison, and passed again after the revert. Not committed here;
+reproduce by editing a checked-out copy of ``catalog.py`` and re-running
+this file.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from holo2.capture.catalog import region_from_record as h2_region_from_record
+from holo2.capture.records import RegionRecord
+from holo2.core import BlobRef
+
+from holo.receive.survey import region_from_record as h1_region_from_record
+from holo.receive.types import SupportRun, SurveyRegionRecord
+
+_MM_PER_INCH = 25.4
+
+
+def _rle_runs(cells: np.ndarray) -> tuple[SupportRun, ...]:
+    """Row-major true-runs of a 2-D boolean grid, v1's ``support_runs``
+    shape (contiguous, non-overlapping, strictly ascending)."""
+    flat = np.asarray(cells, bool).ravel()
+    runs: list[SupportRun] = []
+    index = 0
+    n = flat.size
+    while index < n:
+        if not flat[index]:
+            index += 1
+            continue
+        start = index
+        while index < n and flat[index]:
+            index += 1
+        runs.append(SupportRun(start, index - start))
+    return tuple(runs)
+
+
+def _support_grid(rows: int, cols: int, seed: int, density: float = 0.6
+                  ) -> np.ndarray:
+    rng = np.random.default_rng(seed)
+    grid = rng.random((rows, cols)) < density
+    grid[0, 0] = True   # never an empty grid
+    return grid
+
+
+CASES = [
+    dict(rows=9, cols=13, seed=46001, origin_yx=(40, 17), step_px=6,
+        extent_px=(9 * 6, 13 * 6 - 2), dpi_true=1200.0),
+    dict(rows=1, cols=1, seed=46002, origin_yx=(0, 0), step_px=4,
+        extent_px=(4, 4), dpi_true=600.0),
+    dict(rows=20, cols=5, seed=46003, origin_yx=(5, 5), step_px=3,
+        extent_px=(20 * 3 - 1, 5 * 3), dpi_true=4800.0),
+]
+
+
+@pytest.mark.parametrize("case", CASES, ids=[str(c["seed"]) for c in CASES])
+def test_rebuilt_region_agrees(case) -> None:
+    cells = _support_grid(case["rows"], case["cols"], case["seed"])
+    origin_yx = tuple(int(v) for v in case["origin_yx"])
+    extent_px = tuple(int(v) for v in case["extent_px"])
+    step_px = int(case["step_px"])
+    dpi_true = float(case["dpi_true"])
+
+    # The SupportMask both trees will independently reconstruct — used
+    # here only to compute the shared-formula area_mm2 v1's record
+    # stores verbatim (survey.py:744 is the same expression).
+    from holo.receive.survey import SupportMask as H1SupportMask
+    reference = H1SupportMask(origin_yx, step_px, cells, extent_px)
+    px_per_mm = dpi_true / _MM_PER_INCH
+    area_mm2 = reference.area_px / (px_per_mm * px_per_mm)
+
+    v1_record = SurveyRegionRecord(
+        region_id="row46-region", capture_id="ab" * 32,
+        lane_id="row46-lane", origin_yx=origin_yx, extent_yx=extent_px,
+        support_step_px=step_px, support_shape_yx=cells.shape,
+        support_runs=_rle_runs(cells), area_mm2=area_mm2,
+        median_tensor_score=0.42)
+    v1_region = h1_region_from_record(v1_record)
+
+    h2_record = RegionRecord(
+        capture_sha256="ab" * 32,
+        support_mask_ref=BlobRef("cd" * 32, cells.nbytes),
+        pitch_in_vote=None, support_origin_px=origin_yx,
+        support_step_px=step_px, support_extent_px=extent_px)
+    h2_region = h2_region_from_record(h2_record, cells, dpi_true)
+
+    assert v1_region.support.origin_yx == h2_region.support.origin_yx
+    assert v1_region.support.step_px == h2_region.support.step_px
+    assert v1_region.support.extent_px == h2_region.support.extent_px
+    assert np.array_equal(v1_region.support.cells, h2_region.support.cells)
+    assert v1_region.bbox == h2_region.bbox_px
+    assert v1_region.area_mm2 == pytest.approx(h2_region.area_mm2, rel=1e-12)
+    # v1's is READ verbatim off the record; holo2's is RECOMPUTED fresh
+    # from the rebuilt support — both must equal the shared formula's
+    # own output, not merely each other via a coincidence of rounding.
+    assert v1_region.area_mm2 == pytest.approx(area_mm2, rel=1e-12)
+    assert h2_region.area_mm2 == pytest.approx(area_mm2, rel=1e-12)
