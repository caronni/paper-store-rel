index 0000000..249464f
--- /dev/null
+++ b/tests/holo2_oracles/test_oracle_calibration_readback.py
@@ -0,0 +1,158 @@
+"""Ledger row 43 — float64-fresh vs float32-stored-then-read-back LLRs.
+
+v1's ``_payload_context.py:215-218`` recomputes a member's marginal LLR
+in float64 on every pooled fit, straight from the retained calibration
+knots: ``Calibration(row.placement_id, row.calibration_score_nodes,
+row.calibration_probability_nodes, row.n_search).llr(row.scores)``.
+holo2 never keeps that float64 array around: ``place_shared._tile_
+writes`` stages the LLR as ``LLR_STORE_DTYPE`` (float32, ``:818``) and
+``calibration._member_cells`` reads it back and casts up to float64
+(``:299-308``). DIVERGENCE-LEDGER row 43 calls the difference
+ulp-class and asks for a PIN, "named because F1 changes what is
+computed from these arrays" (row 1's ranking statistic reads exactly
+this readback).
+
+``detect.Calibration``/``detect.fit_calibration`` are carried code,
+identical on both trees (confirmed inline below), so this file fits
+ONE real calibration via v1's ``fit_calibration`` on a real-shaped
+label population, then runs v1's float64-fresh expression and holo2's
+float32-store-then-read-back expression from the SAME knots and the
+SAME real-shaped (4,096-cell tile) score array, and checks the ONLY
+place they may differ: the store's declared float32 cast.
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F).
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``holo2/src/holo2/solve/place_shared.py`` with ``LLR_STORE_DTYPE``
+changed from ``np.float32`` to ``np.float16`` — the FIRST attempt at
+this pin compared holo2's readback against a reference re-derived from
+the same live ``LLR_STORE_DTYPE`` import on both sides of the
+assertion, which passed under the mutation (a self-referential
+comparison catches nothing: whatever the constant says, both sides
+agreed). Fixed by pinning the constant BY NAME
+(``assert LLR_STORE_DTYPE is np.float32``, which now fails first) and
+by rounding v1's reference value through ``np.float32`` EXPLICITLY
+rather than through the imported constant. Passed again after the
+revert. Not committed here; reproduce by editing a checked-out copy of
+``place_shared.py`` and re-running this file.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from holo2.format import TILE_CELLS
+from holo2.solve import detect as h2detect
+from holo2.solve.place_shared import LLR_STORE_DTYPE
+
+from holo.receive import detect as h1detect
+
+WINDOW_ID = "row43-oracle-window"
+
+
+def _real_fit():
+    """One real PAVA fit, via v1's own ``fit_calibration`` — the carried
+    function both trees' ``Calibration`` objects below are checked
+    against.  ``detect.Calibration``/``fit_calibration`` are carried
+    verbatim (asserted below), so fitting once through v1's copy and
+    handing the SAME knots to both trees' ``Calibration`` constructors
+    is the fair setup, not an assumption."""
+    rng = np.random.default_rng(43_000)
+    n = 900
+    site_ids = np.arange(n, dtype=np.int64)
+    labels = (rng.random(n) < 0.5).astype(np.uint8)
+    scores = np.where(labels.astype(bool), rng.normal(2.0, 1.0, n),
+                      rng.normal(-2.0, 1.0, n)).astype(np.float32)
+    half = n // 2
+    fit = h1detect.fit_calibration(
+        h1detect.CalibrationObservations(
+            WINDOW_ID, scores[:half], labels[:half], site_ids[:half]),
+        h1detect.CalibrationObservations(
+            WINDOW_ID, scores[half:], labels[half:], site_ids[half:]))
+    assert fit.accepted and fit.calibration is not None
+    return fit.calibration
+
+
+def test_calibration_llr_is_carried_code_on_a_real_fit() -> None:
+    """Precondition: the SAME knots feed an identical ``.llr`` on both
+    trees, so the readback comparison below isolates the float32 store,
+    not a drifted ``detect`` module."""
+    calibration = _real_fit()
+    scores = np.linspace(-8.0, 8.0, 4096).astype(np.float32)
+    h1_calib = h1detect.Calibration(
+        WINDOW_ID, calibration.knots, calibration.probabilities,
+        calibration.n_search)
+    h2_calib = h2detect.Calibration(
+        WINDOW_ID, calibration.knots, calibration.probabilities,
+        calibration.n_search)
+    assert np.array_equal(h1_calib.llr(scores), h2_calib.llr(scores))
+
+
+def test_readback_equals_float64_of_the_declared_store_dtype() -> None:
+    """The row 43 pin: v1's fresh float64 marginal vs holo2's stage
+    (``LLR_STORE_DTYPE``) -> read-back-as-float64 pipeline, on a
+    real-shaped tile (``TILE_CELLS x TILE_CELLS`` = 4,096 cells, a
+    partially-observed mask as production tiles carry)."""
+    calibration = _real_fit()
+    rng = np.random.default_rng(43_001)
+    n_cells = TILE_CELLS * TILE_CELLS
+    scores = rng.normal(0.0, 3.0, n_cells).astype(np.float32)
+    observed = rng.random(n_cells) < 0.7   # a real tile's partial mask
+
+    # v1's exact expression, _payload_context.py:215-218.
+    h1_calib = h1detect.Calibration(
+        WINDOW_ID, calibration.knots, calibration.probabilities,
+        calibration.n_search)
+    v1_marginal = np.asarray(h1_calib.llr(scores), np.float64)
+
+    # holo2's exact expression, place_shared._tile_writes:816-818 then
+    # calibration._member_cells:299-303 — LLR computed only at observed
+    # cells (a full-tile array with the unobserved cells left 0.0, as
+    # _tile_writes builds it), staged at LLR_STORE_DTYPE, read back and
+    # cast to float64.
+    h2_calib = h2detect.Calibration(
+        WINDOW_ID, calibration.knots, calibration.probabilities,
+        calibration.n_search)
+    llr = np.zeros(n_cells, np.float64)
+    llr[observed] = h2_calib.llr(scores[observed])
+    stored = llr.astype(LLR_STORE_DTYPE)
+    readback = np.asarray(stored, np.float64)
+
+    # The declared store dtype IS the fact this pin is about — pinned by
+    # NAME, not folded into the comparison basis below (a value
+    # comparison built from the same live ``LLR_STORE_DTYPE`` variable
+    # on both sides would pass under ANY dtype the constant took,
+    # including a mutated one — checked by hand, see the module
+    # docstring's non-vacuousness note).
+    assert LLR_STORE_DTYPE is np.float32, (
+        "row 43's whole claim ('ulp-class') is a float32 claim; a "
+        "different store dtype changes the bound below and this pin "
+        "must be re-derived, not silently re-based on it")
+
+    # The ONLY legal source of disagreement is that declared float32
+    # store: readback must equal v1's fresh value rounded through
+    # float32 EXPLICITLY (hardcoded — the reference this row pins v1
+    # against, not read back off the module under test), bit for bit —
+    # no threshold, an identity.
+    expected = v1_marginal.astype(np.float32).astype(np.float64)
+    expected[~observed] = 0.0   # unobserved cells never reach v1's llr()
+    assert np.array_equal(readback, expected), (
+        "the float32-store readback diverges from v1's fresh float64 "
+        "value by more than a float32 round-trip explains")
+
+    # "stays ulp-class" (RULINGS charge), stated from float32's own
+    # machine epsilon rather than an invented number: IEEE-754
+    # round-to-nearest guarantees |round(x) - x| <= |x| * eps for the
+    # target dtype.
+    eps = np.finfo(np.float32).eps
+    delta = np.abs(readback[observed] - v1_marginal[observed])
+    bound = np.abs(v1_marginal[observed]).astype(np.float64) * eps
+    assert np.all(delta <= bound + np.finfo(np.float64).tiny), (
+        f"readback delta exceeded the {LLR_STORE_DTYPE} rounding bound: "
+        f"max delta {delta.max():.3e} vs max bound {bound.max():.3e}")
+    max_delta = float(delta.max()) if delta.size else 0.0
+    max_value = float(np.abs(v1_marginal[observed]).max()) if delta.size else 0.0
+    print(f"row43: max|delta|={max_delta:.6g} over max|v1|={max_value:.6g} "
+         f"({LLR_STORE_DTYPE} eps={eps:.3e})")
diff --git a/tests/holo2_oracles/test_oracle_certificate_work_index.py b/tests/holo2_oracles/test_oracle_certificate_work_index.py
new file mode 100644
index 0000000..58fccc7
--- /dev/null
+++ b/tests/holo2_oracles/test_oracle_certificate_work_index.py
@@ -0,0 +1,119 @@
+"""Ledger row 48 — the certified-content fail-closed invariant, PINNED
+cross-tree.
+
+v1's ``evidence.certificate_work_index`` folds a stream of
+``TileCertificateRecord``s keyed by ``work_key = (page, ty, tx,
+stream_id)``, and raises the moment two records at one key carry
+DIFFERENT ``certificate_id`` strings — a same-id repeat is silently
+accepted (``previous != row.certificate_id`` is the only test). holo2's
+``records.join_tiles`` folds two ``TileRecord``s at one tile key and
+raises ``CertificateConflict`` the moment both are certified with
+DIFFERING content (``bits_ref``/``metadata_bit``); it explicitly
+TOLERATES two certified records that AGREE (row 48's own text: "what
+DOES relax is the MINT of two AGREEING certificates... that is
+corroboration, not contradiction").
+
+Row 48: "Same invariant, different representation (an id string vs
+content fields); an oracle asserting both trees refuse the same
+disagreeing pair and accept the same agreeing pair."
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F).
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``holo2/src/holo2/solve/records.py``'s ``join_tiles`` with the
+disagreement guard's ``or`` changed to ``and`` (so two certificates
+disagreeing on ONLY ``metadata_bit`` would no longer raise) —
+``test_disagreeing_metadata_bit_alone_refuses_on_both_trees`` failed
+(holo2 silently accepted the metadata-bit disagreement), and passed
+again after the revert. Not committed here; reproduce by editing a
+checked-out copy of ``records.py`` and re-running this file.
+"""
+from __future__ import annotations
+
+import hashlib
+
+import pytest
+
+from holo2.core import BlobRef, CertificateConflict, ResourceKey
+from holo2.solve.records import MintRef, TileRecord, join_tiles
+
+from holo.receive.evidence import TileCertificateRecord, certificate_work_index
+
+WORK_KEY = (0, 3, 5, "main")
+
+
+def _v1_cert(certificate_id: str) -> TileCertificateRecord:
+    return TileCertificateRecord(
+        certificate_id=certificate_id, page=WORK_KEY[0],
+        tile_yx=(WORK_KEY[1], WORK_KEY[2]),
+        packed_user_bits=b"\x01" * 8,
+        origin_attempt_id="row48-attempt", stream_id=WORK_KEY[3])
+
+
+def _h2_tile(bits_sha: str, metadata_bit: int, pose_tag: str) -> TileRecord:
+    pose = ResourceKey("pose", (pose_tag,))
+    return TileRecord(
+        minting=MintRef(pose, "scan", "oracle-profile"),
+        bits_ref=BlobRef(bits_sha, 8), metadata_bit=metadata_bit)
+
+
+_SHA_A = hashlib.sha256(b"row48-content-a").hexdigest()
+_SHA_B = hashlib.sha256(b"row48-content-b").hexdigest()
+
+
+def test_disagreeing_content_refuses_on_both_trees() -> None:
+    """v1's two different certificate_id strings; holo2's two different
+    bits_ref shas — the same class of disagreement, spelled two ways."""
+    v1_rows = [_v1_cert("aa" * 32), _v1_cert("bb" * 32)]
+    with pytest.raises(ValueError, match="conflicting certificates"):
+        certificate_work_index(v1_rows)
+
+    left = _h2_tile(_SHA_A, 0, "p1")
+    right = _h2_tile(_SHA_B, 0, "p2")
+    with pytest.raises(CertificateConflict):
+        join_tiles(None, left, right)
+
+
+def test_disagreeing_metadata_bit_alone_refuses_on_both_trees() -> None:
+    """The content fields disagree on ONLY the metadata bit — v1 has no
+    separate metadata-bit field (it lives inside packed_user_bits, so a
+    real disagreement there changes certificate_id too); holo2 keys it
+    apart explicitly. Both trees must still refuse."""
+    left = _h2_tile(_SHA_A, 0, "p1")
+    right = _h2_tile(_SHA_A, 1, "p2")   # same bits, opposite metadata bit
+    with pytest.raises(CertificateConflict):
+        join_tiles(None, left, right)
+
+
+def test_agreeing_mint_is_accepted_on_both_trees() -> None:
+    """Two records naming the SAME certified content but a DIFFERENT
+    minting witness (v1: the same certificate_id, a repeat; holo2: the
+    same bits_ref/metadata_bit, a different pose/route) — corroboration,
+    not contradiction, on both trees."""
+    same_id = "cc" * 32
+    v1_rows = [_v1_cert(same_id), _v1_cert(same_id)]
+    index = certificate_work_index(v1_rows)   # must not raise
+    assert index[WORK_KEY] == same_id
+
+    left = _h2_tile(_SHA_A, 1, "p1")
+    right = _h2_tile(_SHA_A, 1, "p2")   # same content, different pose
+    joined = join_tiles(None, left, right)   # must not raise
+    assert joined.certified
+    assert joined.bits_ref == left.bits_ref
+    assert joined.metadata_bit == 1
+    # the standing mint's provenance is kept, per join_tiles' own rule.
+    assert joined.minting == left.minting
+
+
+def test_first_certified_side_wins_the_kept_provenance() -> None:
+    """``join_tiles`` keeps ``current``'s minting when BOTH are
+    certified and agree — checked directly rather than assumed, since
+    row 48's charge is about the REFUSAL, not this tie-break, and a
+    future change here would silently move which attempt's provenance a
+    corroborated tile reports."""
+    left = _h2_tile(_SHA_A, 0, "first")
+    right = _h2_tile(_SHA_A, 0, "second")
+    assert join_tiles(None, left, right).minting.pose_id.parts == ("first",)
+    assert join_tiles(None, right, left).minting.pose_id.parts == ("second",)
diff --git a/tests/holo2_oracles/test_oracle_close_state_gate.py b/tests/holo2_oracles/test_oracle_close_state_gate.py
new file mode 100644
index 0000000..a2645e3
--- /dev/null
+++ b/tests/holo2_oracles/test_oracle_close_state_gate.py
@@ -0,0 +1,182 @@
+"""Ledger row 55 — the INCREMENTAL count-ready gate, PINNED cross-tree.
+
+v1's ``close_count_ready`` (``fountain_close.py:525``, via
+``close_count_status``) is a BATCH function: given the whole certificate
+set so far, decide whether a full close attempt could possibly become
+terminal. holo2 additionally carries ``solve/close.py``'s
+``_CloseState``/``_MetadataGate`` — an INCREMENTAL re-implementation
+(P3-1) that folds one certificate at a time (an echelon metadata basis,
+a distinct-ESI counter per block) so a live consult pays O(new
+certificates) instead of O(certified).
+
+``holo2/tests/holo2_oracles/test_oracle_close.py`` already pins
+``format/fountain_close.close_count_ready`` — the CARRIED batch
+function — against v1's, cross-tree (``test_count_gate_agrees``). That
+is a DIFFERENT object from this file's target: ``solve/close.py``'s
+incremental gate is holo2's OWN arithmetic, written to match the batch
+function's answer at every count without ever calling it, and nothing
+before this file drove it against v1's real gate. DIVERGENCE-LEDGER row
+55: "The one piece of the close holo2 wrote itself... the discriminating
+measurement: an oracle asserting count_ready == close_count_ready(certs,
+spec) over a certificate stream."
+
+This file certifies a real page's tiles one at a time through v1's own
+decode chain, feeds each certificate into a fresh ``_CloseState``
+(mirroring v1's certificate content field-for-field, the ``mirror()``
+shape ``test_oracle_close.py`` already uses), and asserts
+``state.ready == close_count_ready(certs[:n], spec)`` at every prefix
+length — spanning the metadata trust floor (48 equations) and the
+count-ready threshold (``k_total`` distinct ESIs), so both of
+``_CloseState.ready``'s two ways of becoming true (``count_ready`` and
+``metadata.terminal``) get exercised.
+
+Lives here (not ``holo2/tests``) because only ``tests/holo2_oracles/``
+and ``measure/verdicts/test_v1_parity.py`` may import ``holo`` (RULINGS
+§F).
+
+Non-vacuousness (RULINGS charge): checked by hand against a scratch copy
+of ``holo2/src/holo2/solve/close.py``'s ``_StreamCounts.add`` with the
+``self.short -= 1`` transition changed to fire one distinct-ESI count
+early (``== code.k_per_block[block] - 1``) — ``test_incremental_gate_
+matches_batch_gate_at_every_prefix`` failed at the prefix just below the
+true count-ready threshold (incremental said ready a step early), and
+passed again after the revert. Not committed here; reproduce by editing
+a checked-out copy of ``close.py`` and re-running this file.
+"""
+from __future__ import annotations
+
+import hashlib
+
+import numpy as np
+import pytest
+
+from holo.core import fountain as h_fountain
+from holo.format.resolve import resolve_format_ref as h_resolve_format_ref
+from holo.gen.compose import compose_page_cells
+from holo.gen.emit import source_packed_for
+from holo.gen.plan import plan_volume
+from holo.receive import fountain_close as h_close
+from holo.receive.evidence import AttemptStage, AttemptState
+from holo.receive.payload import attempt_k_tile
+from holo.receive.records import certificate_for_close
+
+from holo2.core import ResourceKey
+from holo2.format.resolve import format_row_for
+from holo2.solve.close import _CloseState
+
+#: 144 tiles/page, sized so ``plan.k_total`` (chosen below, ~57) sits
+#: ABOVE ``MIN_METADATA_EQUATIONS`` (48) at ``n_pages == 1`` — the
+#: production regime (a real sheet's k_total is in the hundreds to
+#: thousands). ``c3-k-r0550@8x8``'s 64-tile page tops out at k_total~40
+#: with n_pages still 1, which puts the count-ready transition BEHIND
+#: the metadata trust floor: ``_CloseState._settle`` cannot build its
+#: per-stream counters until metadata resolves (``self.counts`` stays
+#: ``None`` — see ``close.py``'s own ``_settle``), so with that smaller
+#: format count-ready and metadata-trust resolve in the SAME step and a
+#: mutation that only shifts the count transition is invisible — found
+#: by hand while building this fixture, kept here so it is not
+#: rediscovered.
+FORMAT_REF = "c2-k-r0700@12x12"
+_PAYLOAD_REPEATS = 600      # -> plan.k_total ~57 at rate 0.9, n_pages=1
+_RATE = 0.9
+_SOURCE_SHA = hashlib.sha256(b"row55-close-gate-oracle").hexdigest()
+
+
+def _mirror(cert: h_close.CertifiedStreamSymbol) -> tuple[int, str, int]:
+    """The same certified equation, as ``_CloseState._ingest`` reads it:
+    it never touches a ``CertifiedStreamSymbol`` object, only the three
+    scalars — so this returns exactly that tuple rather than minting a
+    holo2 dataclass nothing else here needs."""
+    return (cert.counter, cert.stream_id, int(cert.metadata_bit))
+
+
+@pytest.fixture(scope="module")
+def cert_stream():
+    spec = h_resolve_format_ref(FORMAT_REF)
+    payload = hashlib.sha256(b"row55-oracle-payload").digest() * _PAYLOAD_REPEATS
+    plan = plan_volume(spec, len(payload), _RATE)
+    assert plan.n_pages == 1
+    assert plan.k_total > 48, (
+        "fixture assumption: k_total must clear the metadata trust "
+        f"floor on its own (got {plan.k_total}) — see the FORMAT_REF "
+        "comment above")
+    source = source_packed_for(payload, plan)
+    code = h_fountain.VolumeCode(
+        plan.k_total, plan.symbol_bits, spec.seed,
+        tiles_per_page=spec.tiles_per_page)
+    symbols = code.encode_symbols(
+        source, np.arange(spec.tiles_per_page, dtype=np.int64))
+    field = compose_page_cells(spec, 0, symbols, plan.k_total)
+    tiles_x = spec.layout.tiles_yx[1]
+
+    certs = []
+    for index in range(spec.tiles_per_page):
+        ty, tx = divmod(index, tiles_x)
+        tile = field[ty * 64:(ty + 1) * 64, tx * 64:(tx + 1) * 64]
+        _record, certified = attempt_k_tile(
+            (tile.astype(np.float64) * 2.0 - 1.0) * 5.0,
+            spec, (0, ty, tx), AttemptStage.SCAN,
+            source_sha256=_SOURCE_SHA, lane_id="row55-oracle",
+            component_block_ids=(hashlib.sha256(
+                f"row55-{index}".encode()).hexdigest(),))
+        assert _record.state is AttemptState.CERTIFIED
+        certs.append(certificate_for_close(certified, spec))
+
+    row = format_row_for(FORMAT_REF, plan.n_pages)
+    return dict(spec=spec, certs=tuple(certs), k_total=plan.k_total,
+               h2spec=row.close_spec())
+
+
+# checked at: below the metadata trust floor, at it, just above it, well
+# below k_total, at k_total - 1, at k_total exactly, and past it.
+def _checkpoints(k_total: int, n_certs: int) -> list[int]:
+    raw = sorted({1, 24, 47, 48, 49, max(1, k_total - 1), k_total,
+                 min(n_certs, k_total + 1), n_certs})
+    return [n for n in raw if 1 <= n <= n_certs]
+
+
+def test_incremental_gate_matches_batch_gate_at_every_prefix(
+        cert_stream) -> None:
+    spec = cert_stream["spec"]
+    certs = cert_stream["certs"]
+    assert len(certs) >= 48, "fixture must clear the metadata trust floor"
+
+    state = _CloseState(cert_stream["h2spec"])
+    checkpoints = set(_checkpoints(cert_stream["k_total"], len(certs)))
+    seen_true = seen_false = False
+    for n, cert in enumerate(certs, start=1):
+        counter, stream_id, bit = _mirror(cert)
+        state._ingest(ResourceKey("row55-tile", (str(n),)),
+                     stream_id, counter, bit)
+        state._settle()
+        if n in checkpoints:
+            expected = h_close.close_count_ready(certs[:n], spec)
+            assert state.ready == expected, (
+                f"incremental gate diverged from the batch gate at "
+                f"n={n} (incremental={state.ready}, batch={expected})")
+            seen_true = seen_true or expected
+            seen_false = seen_false or not expected
+    assert seen_true and seen_false, (
+        "the checkpoint set must cross the readiness transition, or "
+        "this pin never exercises the interesting half of the gate")
+
+
+def test_count_ready_alone_agrees_below_the_metadata_floor(
+        cert_stream) -> None:
+    """``_CloseState.count_ready`` (distinct-ESI counts only, no
+    metadata-terminal fallback) against the batch gate restricted to the
+    same population, on a short prefix where metadata cannot yet have
+    settled — the half of ``.ready`` that is not ``metadata.terminal``."""
+    spec = cert_stream["spec"]
+    certs = cert_stream["certs"][:10]
+    state = _CloseState(cert_stream["h2spec"])
+    for n, cert in enumerate(certs, start=1):
+        counter, stream_id, bit = _mirror(cert)
+        state._ingest(ResourceKey("row55-tile", (str(n),)),
+                     stream_id, counter, bit)
+    state._settle()
+    assert not state.metadata.terminal, (
+        "fixture assumption: 10 certificates sit below the 48-equation "
+        "trust floor")
+    assert state.count_ready == state.ready
+    assert state.ready == h_close.close_count_ready(certs, spec)
diff --git a/tests/holo2_oracles/test_oracle_cold_search.py b/tests/holo2_oracles/test_oracle_cold_search.py
