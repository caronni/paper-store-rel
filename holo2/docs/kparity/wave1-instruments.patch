@@ -0,0 +1,279 @@
+"""Pins ``holo2/measure/rf1_gate_flips.py``'s PURE logic — M1 (RULINGS §N,
+DIVERGENCE-LEDGER row 5, 2026-08-28).
+
+Lives here, not ``holo2/tests``, for the same reason
+``test_oracle_tile_differential.py``/``test_oracle_refine.py`` do: it is
+one of the two places allowed to import ``holo`` (RULINGS §F carries the
+pre-existing rule — "only ``tests/holo2_oracles/`` +
+``measure/verdicts/test_v1_parity.py`` may import v1"). The instrument
+itself is a state-driven READ (no fixture pytest can build cheaply — a
+full RF1 revision needs a committed pose, a certificate frontier and a
+prepared plane); what pytest CAN pin, without a store or a decode, is the
+arithmetic ``rf1_gate_flips.py`` wires together, and getting any one of
+these wirings backwards would make the real driver's flip count silently
+wrong on real sheets:
+
+* :func:`~rf1_gate_flips.ctx_corrected_logits` — v1's own
+  ``certified_refine._fixed_detector_logits`` CONTEXT_PROFILE branch
+  (``bins = np.where(valid, counts, -1)``, then the shared clamp kernel),
+  pinned against v1's OWN ``context_neighbour_counts``/
+  ``apply_context_offsets`` calls on the same synthetic population — the
+  same "call v1's code, never retype its numbers" discipline
+  ``test_oracle_ctx_apply.py`` states (the e012 keystream lesson).
+* :func:`~rf1_gate_flips.score_and_gate` — the base/candidate ordering
+  ``refine_fit.adoption_gate`` needs (``candidate_loss + MIN_HELDOUT_GAIN
+  < baseline_loss``, not the reverse) and the pilot/valid row split; a
+  swapped ``base_logits``/``cand_logits`` argument pair would silently
+  turn every real REFUSAL into an ADOPTION and vice versa, which the
+  DIRECTIONAL fixture below (:func:`test_score_and_gate_is_directional`)
+  is built to catch.
+* :func:`~rf1_gate_flips.is_flip` — directional (row 5's own question:
+  "adoptions v1's scoring would refuse"), never the symmetric
+  ``adopted_a != adopted_b``.
+* :func:`~rf1_gate_flips.quarantine_missing` — ``all - filtered``, never
+  the reverse (``refine.reaches`` only ever DROPS pieces).
+* :func:`~rf1_gate_flips.support_deficit` — the sign convention a
+  negative deficit (observed > support) is a frame-mismatch signal, not
+  a value to clamp away.
+
+Both packages may be imported HERE, outside the holo2 tree (the firewall
+forbids holo2 importing the original), the same standing every other
+oracle in this directory has.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+_HERE = Path(__file__).resolve().parent
+_ROOT = _HERE.parent.parent
+for _path in (_ROOT / "src", _ROOT / "holo2" / "src",
+             _ROOT / "holo2" / "measure"):
+    _str = str(_path)
+    if _str not in sys.path:
+        sys.path.insert(0, _str)
+
+from holo.receive import detect as v1_detect               # noqa: E402
+
+import rf1_gate_flips as rgf                                # noqa: E402
+from holo2.core import ResourceKey                           # noqa: E402
+
+
+# ---------------------------------------------------------------------------
+# ctx_corrected_logits — v1's _fixed_detector_logits CONTEXT_PROFILE branch
+# ---------------------------------------------------------------------------
+
+
+def _dense_population(seed: int, side: int = 6):
+    """A dense ``side``x``side`` block of page cells (some interior, with
+    complete eight-neighbourhoods; some on the border, without) — the
+    same shape ``test_oracle_ctx_apply.py``'s ``_population`` exercises,
+    small enough to hand-inspect."""
+    rng = np.random.default_rng(seed)
+    ys, xs = np.mgrid[0:side, 0:side]
+    cells = np.stack((ys.ravel(), xs.ravel()), axis=1).astype(np.int64)
+    marginal = rng.normal(size=cells.shape[0])
+    return cells, marginal
+
+
+def test_ctx_corrected_logits_matches_v1_fixed_detector_logits():
+    """``rf1_gate_flips.ctx_corrected_logits`` against v1's OWN
+    ``context_neighbour_counts``/``apply_context_offsets`` calls, wired
+    exactly as ``certified_refine._fixed_detector_logits``'s
+    CONTEXT_PROFILE branch (``certified_refine.py:707-715``) does:
+    ``bins = np.where(valid, counts, -1)`` off ``marginal > 0``, then the
+    clamp kernel. The 6x6 grid guarantees both a border (bin -1) and an
+    interior (bin 0..8) population in one call.
+    """
+    cells, marginal = _dense_population(seed=1)
+    offsets = np.linspace(-2.7, 2.7, 9)
+
+    counts, valid = v1_detect.context_neighbour_counts(cells, marginal > 0.0)
+    bins = np.where(valid, counts, -1).astype(np.int8)
+    expected = v1_detect.apply_context_offsets(marginal, bins, offsets)
+
+    got = rgf.ctx_corrected_logits(marginal, cells, offsets)
+    np.testing.assert_array_equal(got, expected)
+    # both populations are real (not a degenerate all-interior or
+    # all-border grid, which would leave the ``np.where`` untested on one
+    # side)
+    assert valid.any() and (~valid).any()
+
+
+def test_ctx_corrected_logits_zero_offsets_is_marginal_identity():
+    """The PAVA_PROFILE fallback this script uses for a pool with no
+    adopted fit (module docstring point 3): zero offsets must return the
+    marginal logits UNCHANGED at every valid bin, and bin -1 cells are
+    untouched regardless (``apply_context_offsets``'s own contract)."""
+    cells, marginal = _dense_population(seed=2)
+    got = rgf.ctx_corrected_logits(marginal, cells, np.zeros(9))
+    np.testing.assert_array_equal(got, marginal)
+
+
+# ---------------------------------------------------------------------------
+# score_and_gate — the base/candidate wiring into refine_fit.adoption_gate
+# ---------------------------------------------------------------------------
+
+
+def _gate_inputs(n_valid: int = 200, n_pilots: int = 40,
+                 disjoint: bool = False) -> rgf.GateInputs:
+    """``disjoint=True`` puts the pilot rows OUTSIDE the valid-row range
+    (``n_valid .. n_valid+n_pilots``), so a caller can move one
+    population's logits without moving the other's — needed to isolate
+    the gate's pilot-mismatch clause from its held-out-loss clause
+    (:func:`test_score_and_gate_refuses_on_pilot_regression_...`)."""
+    valid_rows = np.arange(n_valid, dtype=np.int64)
+    valid_values = np.zeros(n_valid, np.uint8)
+    valid_values[: n_valid // 2] = 1
+    valid_weights = np.ones(n_valid, np.float64)
+    pilot_start = n_valid if disjoint else 0
+    pilot_rows = np.arange(pilot_start, pilot_start + n_pilots,
+                           dtype=np.int64)
+    pilot_values = np.zeros(n_pilots, np.uint8)
+    pilot_values[: n_pilots // 2] = 1
+    return rgf.GateInputs(valid_rows, valid_values, valid_weights,
+                          pilot_rows, pilot_values, 0.0, 0.0)
+
+
+def _logits_for(values: np.ndarray, n: int, strength: float) -> np.ndarray:
+    """A logit array whose sign matches ``values`` at rows < len(values)
+    (``strength`` nats of confidence) and is neutral elsewhere."""
+    out = np.zeros(n, np.float64)
+    sign = np.where(values > 0, 1.0, -1.0)
+    out[: values.size] = sign * strength
+    return out
+
+
+def _place(out: np.ndarray, rows: np.ndarray, values: np.ndarray,
+          strength: float, *, agree: bool = True) -> np.ndarray:
+    """Set ``out[rows]`` to a confident logit matching (or, ``agree=
+    False``, contradicting) ``values``'s sign, in place; returns ``out``
+    for chaining."""
+    sign = np.where(values > 0, 1.0, -1.0) * (1.0 if agree else -1.0)
+    out[rows] = sign * strength
+    return out
+
+
+def test_score_and_gate_adopts_a_clearly_better_candidate():
+    """A candidate whose logits separate the held-out classes cleanly
+    while the baseline's are near-neutral: strictly positive held-out
+    gain, zero pilot/raw mismatch on both sides -> ADOPTED."""
+    gi = _gate_inputs()
+    n = max(gi.valid_rows.max(), gi.pilot_rows.max()) + 1
+    base_logits = _logits_for(gi.valid_values, n, strength=0.05)
+    cand_logits = _logits_for(gi.valid_values, n, strength=4.0)
+
+    adopted, base_loss, cand_loss = rgf.score_and_gate(
+        base_logits, cand_logits, gi)
+    assert adopted is True
+    assert cand_loss < base_loss
+
+
+def test_score_and_gate_is_directional():
+    """Swapping ``base_logits``/``cand_logits`` must REVERSE the
+    verdict — the fork this pin exists to catch (module docstring): a
+    driver that fed the pair in the wrong order would silently turn
+    every real gate-flip count into its complement."""
+    gi = _gate_inputs()
+    n = max(gi.valid_rows.max(), gi.pilot_rows.max()) + 1
+    weak_logits = _logits_for(gi.valid_values, n, strength=0.05)
+    strong_logits = _logits_for(gi.valid_values, n, strength=4.0)
+
+    adopted_forward, _, _ = rgf.score_and_gate(weak_logits, strong_logits, gi)
+    adopted_reversed, _, _ = rgf.score_and_gate(
+        strong_logits, weak_logits, gi)
+    assert adopted_forward is True
+    assert adopted_reversed is False
+
+
+def test_score_and_gate_refuses_a_worse_candidate():
+    """A candidate whose logits separate WORSE than the baseline's must
+    refuse on the held-out-gain clause alone."""
+    gi = _gate_inputs()
+    n = max(gi.valid_rows.max(), gi.pilot_rows.max()) + 1
+    base_logits = _logits_for(gi.valid_values, n, strength=4.0)
+    cand_logits = _logits_for(gi.valid_values, n, strength=0.5)
+
+    adopted, base_loss, cand_loss = rgf.score_and_gate(
+        base_logits, cand_logits, gi)
+    assert adopted is False
+    assert cand_loss > base_loss
+
+
+def test_score_and_gate_refuses_on_pilot_regression_even_with_lower_loss():
+    """A candidate with a strictly lower held-out loss but a pilot
+    mismatch that regresses past ``PILOT_MISMATCH_SLACK`` must still
+    refuse — the gate's second clause, exercised independently of the
+    first (pilot rows are DISJOINT from valid rows here, so flipping the
+    pilots' sign cannot itself move the held-out loss) so a driver that
+    dropped the clause (scored on held-out gain alone) would fail here
+    even though :func:`test_score_and_gate_adopts_a_clearly_better_candidate`
+    still passes."""
+    gi = _gate_inputs(disjoint=True)
+    n = int(max(gi.valid_rows.max(), gi.pilot_rows.max())) + 1
+    base_logits = _place(np.zeros(n), gi.valid_rows, gi.valid_values, 3.0)
+    base_logits = _place(base_logits, gi.pilot_rows, gi.pilot_values, 3.0)
+    # candidate: better held-out separation on the VALID rows, but every
+    # PILOT row's sign is flipped (perfect pilot disagreement)
+    cand_logits = _place(np.zeros(n), gi.valid_rows, gi.valid_values, 6.0)
+    cand_logits = _place(cand_logits, gi.pilot_rows, gi.pilot_values, 6.0,
+                         agree=False)
+
+    adopted, base_loss, cand_loss = rgf.score_and_gate(
+        base_logits, cand_logits, gi)
+    assert cand_loss < base_loss, "premise: candidate held-out loss is lower"
+    assert adopted is False
+
+
+# ---------------------------------------------------------------------------
+# the small standalone helpers
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("adopted_a,adopted_b,expected", [
+    (True, False, True),
+    (True, True, False),
+    (False, False, False),
+    (False, True, False),
+])
+def test_is_flip_is_directional(adopted_a, adopted_b, expected):
+    """A FLIP is (a) ADOPTED and (b) REFUSED — never the symmetric
+    ``!=``, which would also fire on the (impossible for a committed
+    revision, but worth refusing anyway) reverse case."""
+    assert rgf.is_flip(adopted_a, adopted_b) is expected
+
+
+def test_support_deficit_sign_and_fraction():
+    deficit, frac = rgf.support_deficit(support_count=200, observed_count=180)
+    assert deficit == 20
+    assert frac == pytest.approx(0.10)
+
+    # more observed than support: a frame mismatch, surfaced as negative
+    # rather than clamped to zero (module docstring)
+    deficit, frac = rgf.support_deficit(support_count=100, observed_count=120)
+    assert deficit == -20
+    assert frac == pytest.approx(-0.20)
+
+    deficit, frac = rgf.support_deficit(support_count=0, observed_count=0)
+    assert deficit == 0
+    assert np.isnan(frac)
+
+
+def test_quarantine_missing_is_all_minus_filtered_never_reversed():
+    a = ResourceKey("evidence", ("a",))
+    b = ResourceKey("evidence", ("b",))
+    c = ResourceKey("evidence", ("c",))
+
+    # the ordinary case: filtered is a subset of all (quarantine only
+    # ever drops)
+    assert rgf.quarantine_missing((a, b, c), (a, c)) == frozenset({b})
+    # nothing dropped
+    assert rgf.quarantine_missing((a, b), (a, b)) == frozenset()
+    # a filtered set naming something OUTSIDE ``all`` (should never
+    # happen from real store data, since reach() only ever narrows
+    # pose_evidence_keys' own output) contributes nothing to "missing" —
+    # the function reports what ALL lost, not what FILTERED gained
+    assert rgf.quarantine_missing((a,), (a, b)) == frozenset()
